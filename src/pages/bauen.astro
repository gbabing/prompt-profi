---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Eigenen Prompt bauen · Prompt-Profi">
  <a href="/" class="back-link">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;vertical-align:-2px;margin-right:4px;"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
    Startseite
  </a>

  <header class="kueche-head">
    <button id="k-reset" class="k-reset-btn" type="button">↺ Neu anfangen</button>
    <h1>Eigenen Prompt bauen</h1>
    <p class="kueche-intro">Sag der KI mit ein paar Klicks, was du brauchst – wir führen dich Schritt für Schritt zum fertigen Prompt. Nur die ersten beiden Schritte sind nötig; die weiteren machen den Prompt noch genauer. Am Ende hast du einen fertigen Text zum Kopieren.</p>
  </header>

  <p class="sr-only" id="k-announce" aria-live="polite"></p>

  <div class="kueche-layout">
    <div class="kueche-main">
      <div class="kueche-flow">
        <p class="k-settings-summary" id="k-settings-summary" hidden></p>
        <div class="wz-dots kueche-progress" id="k-progress" role="group" aria-label="Stationen – zu besuchten springen"></div>
        <div class="kueche-station-head">
          <p class="kueche-stepline"><span id="k-step"></span></p>
          <h2 id="k-label"></h2>
          <span class="kueche-sub"><span id="k-icon" aria-hidden="true"></span> <span id="k-pflicht"></span></span>
          <p class="kueche-guide" id="k-guide"></p>
          <button id="k-example-btn" class="k-example-link" type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18h6M10 21h4"/><path d="M8.4 15A6 6 0 1 1 15.6 15c-.5.5-.9 1-1 2h-5.2c-.1-1-.5-1.5-1-2Z"/></svg>
            Zeig mir an einem Beispiel, wie das funktioniert
          </button>
        </div>
        <div id="k-body" class="kueche-body" tabindex="-1"></div>
        <div class="kueche-nav">
          <button id="k-back" class="wz-back" type="button">Zurück</button>
          <button id="k-next" class="wz-next" type="button">Weiter</button>
        </div>
      </div>
    </div>

    <aside class="kueche-preview" id="k-preview" aria-label="Live-Vorschau deines Prompts">
      <div class="k-preview-head">
        <button class="k-preview-toggle" id="k-preview-toggle" type="button" aria-expanded="true" aria-controls="k-preview-body">
          <span class="k-preview-caret" aria-hidden="true"></span>
          <span class="k-preview-title">Dein Prompt <small>wächst mit</small></span>
        </button>
        <button class="k-preview-copy" id="k-preview-copy" type="button" hidden>Kopieren</button>
      </div>
      <div class="k-preview-body" id="k-preview-body">
        <p class="k-preview-empty" id="k-preview-empty">Wähle links eine Aufgabe – hier wächst dein Prompt Schritt für Schritt.</p>
        <div id="k-preview-sections"></div>
      </div>
    </aside>
  </div>

  <noscript>
    <p style="margin-top:1.5rem">Dieser Baukasten braucht JavaScript. <a href="/tool">Zu den fertigen Prompts →</a></p>
  </noscript>

  <!-- Erklär-Modal: „So entsteht ein Prompt" -->
  <div id="k-example-modal" class="modal" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="k-ex-title">
    <div class="modal-backdrop" data-ex-close></div>
    <article class="modal-content k-ex">
      <header>
        <h2 id="k-ex-title">So entsteht aus deinen Angaben ein Prompt</h2>
        <button class="icon-btn" data-ex-close aria-label="Schließen" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </header>
      <p class="modal-desc">Du klickst ein paar einfache Sachen an – der Baukasten schreibt daraus einen sauber aufgebauten Prompt. Hier ein Beispiel, Angabe für Angabe:</p>
      <p class="k-ex-scenario">Angenommen, du möchtest deiner <strong>7. Klasse in Biologie</strong> das Thema „Photosynthese" verständlich erklären lassen. Das gibst du an – und das macht der Baukasten daraus:</p>
      <ol class="k-ex-rows" id="k-ex-rows"></ol>
      <div class="k-ex-full">
        <p class="k-ex-full-label">Zum Schluss bringt der Baukasten alle Bausteine in eine klare Struktur – das ist dein fertiger Prompt zum Kopieren:</p>
        <pre class="k-ex-full-text" id="k-ex-full-text"></pre>
      </div>
      <div class="k-ex-foot">
        <button class="ais-btn" id="k-ex-start" type="button">Alles klar – jetzt selbst bauen</button>
      </div>
    </article>
  </div>
</Layout>

<style is:global>
  .kueche-head { margin-bottom: 1.5rem; position: relative; }
  .kueche-head h1 {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 5vw, 2.8rem);
    font-weight: 700;
    color: var(--color-dark);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0.4rem 0 0.6rem;
  }
  .kueche-intro { margin: 0 0 1.1rem; max-width: 640px; font-size: 1.03rem; line-height: 1.6; color: var(--text-secondary); }

  .k-reset-btn {
    position: absolute; top: 0; right: 0;
    background: none; border: 1px solid var(--border-strong); border-radius: var(--radius-pill);
    padding: 0.35rem 0.8rem; font: inherit; font-size: 0.8rem; font-weight: 600;
    color: var(--text-secondary); cursor: pointer; transition: color 0.15s, border-color 0.15s;
  }
  .k-reset-btn:hover { color: var(--color-primary); border-color: var(--color-primary); }
  .k-reset-btn:focus-visible { outline: none; box-shadow: 0 0 0 3px var(--color-primary-soft); }

  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

  .k-settings-summary {
    margin: 0 0 0.9rem; padding: 0.4rem 0.75rem;
    background: var(--bg-secondary); border-radius: var(--radius-pill);
    font-size: 0.8rem; color: var(--text-secondary); display: inline-block;
  }

  .k-thema-ex { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; margin-top: 0.5rem; }
  .k-thema-ex-label { font-size: 0.78rem; color: var(--text-tertiary); }
  .k-thema-chip {
    background: var(--surface); border: 1px solid var(--border-strong); border-radius: var(--radius-pill);
    padding: 0.3rem 0.75rem; font: inherit; font-size: 0.8rem; color: var(--text); cursor: pointer;
    transition: all 0.15s var(--ease-smooth);
  }
  .k-thema-chip:hover { border-color: var(--color-primary); color: var(--color-primary); }
  .k-thema-chip:focus-visible { outline: none; box-shadow: 0 0 0 3px var(--color-primary-soft); }

  @media (prefers-reduced-motion: reduce) {
    .k-flash { animation: none; }
    .k-rezept-card, .k-preview-caret, .k-dot .wz-dot, .tile, .nachfass-chip, .k-thema-chip, .wz-chip, .ais-btn, .secondary-btn { transition: none; }
  }

  .kueche-settings {
    margin: 0 0 1.75rem;
    padding: 1.1rem 1.25rem 1.25rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .kueche-settings-sub { margin: 0 0 0.9rem; font-size: 0.85rem; color: var(--text-secondary); }
  .kueche-settings-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.8rem; }

  .builder-field select {
    padding: 0.45rem 0.65rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: 0.9rem;
    background: var(--surface);
    color: var(--text);
    width: 100%;
    margin-top: 0.1rem;
  }
  .builder-field select:focus { outline: none; border-color: var(--color-primary); box-shadow: 0 0 0 3px var(--color-primary-soft); }

  /* ===== Zwei-Spalten-Layout: Flow + Live-Vorschau ===== */
  .kueche-layout { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 1.5rem; align-items: start; }

  .kueche-flow {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 1.5rem 1.5rem 1.4rem;
    box-shadow: var(--shadow-sm);
  }
  .kueche-progress { margin-bottom: 1.2rem; flex-wrap: wrap; gap: 2px; }
  /* Punkt als großzügiges Tap-/Klick-Ziel (min. 32px) mit kleinem sichtbaren Punkt innen */
  .k-dot { display: inline-flex; align-items: center; justify-content: center; min-width: 30px; min-height: 32px; padding: 0; margin: 0; background: none; border: none; cursor: pointer; }
  .k-dot:disabled { cursor: default; }
  .k-dot:not(:disabled):hover .wz-dot { transform: scale(1.35); }
  .k-dot:focus-visible { outline: none; }
  .k-dot:focus-visible .wz-dot { box-shadow: 0 0 0 3px var(--color-primary-soft); }

  .kueche-station-head { margin-bottom: 1.1rem; }
  .kueche-station-head h2 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-dark);
    line-height: 1.2;
    margin: 0 0 0.25rem;
  }
  .kueche-sub { font-size: 0.82rem; color: var(--text-tertiary); }
  .kueche-badge {
    display: inline-block;
    margin-left: 0.35rem;
    padding: 0.05rem 0.5rem;
    border-radius: var(--radius-pill);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .kueche-badge.is-pflicht  { background: var(--color-primary-soft); color: var(--color-primary-hover); }
  .kueche-badge.is-optional { background: var(--bg-secondary); color: var(--text-tertiary); }

  .kueche-stepline { margin: 0 0 0.15rem; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-primary-hover); }
  .kueche-guide { margin: 0.55rem 0 0; font-size: 0.94rem; line-height: 1.55; color: var(--text-secondary); }
  .k-usage { margin: 0.1rem 0 0.3rem; padding-left: 1.2rem; }
  .k-usage li { font-size: 0.92rem; line-height: 1.7; color: var(--text); }

  .kueche-body { outline: none; }
  .kueche-body > * + * { margin-top: 0.9rem; }

  .kueche-nav { display: flex; justify-content: space-between; gap: 0.75rem; margin-top: 1.4rem; }

  /* Rezept-Auswahl (Station 1) */
  .k-rezept-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 0.7rem; }
  .k-rezept-card {
    display: flex; flex-direction: column; gap: 0.2rem;
    text-align: left;
    background: var(--surface);
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius);
    padding: 0.85rem 0.95rem;
    cursor: pointer;
    font: inherit;
    transition: border-color 0.15s var(--ease-smooth), box-shadow 0.15s, transform 0.15s;
  }
  .k-rezept-card:hover { border-color: var(--color-primary); transform: translateY(-2px); box-shadow: var(--shadow-sm); }
  .k-rezept-card:focus-visible { outline: none; box-shadow: 0 0 0 3px var(--color-primary-soft); }
  .k-rezept-card.selected { border-color: var(--color-primary); background: var(--color-primary-soft); }
  .k-rezept-icon { line-height: 0; color: var(--text); }
  .k-rezept-icon svg { width: 24px; height: 24px; display: block; }
  .k-rezept-label { font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; color: var(--color-dark); }
  .k-rezept-desc { font-size: 0.82rem; color: var(--text-secondary); line-height: 1.4; }

  /* Feld-Gruppen (Chips) */
  .kueche-fieldset + .kueche-fieldset { margin-top: 1rem; }
  .kueche-fieldlabel { display: block; font-size: 0.85rem; font-weight: 600; color: var(--color-dark); margin-bottom: 0.45rem; }
  .kueche-hint { font-size: 0.82rem; color: var(--text-secondary); line-height: 1.5; }
  .k-linklike { background: none; border: none; padding: 0; font: inherit; color: var(--color-primary); cursor: pointer; text-decoration: underline; }
  .k-linklike:hover { color: var(--color-primary-hover); }

  /* Info-Button je Eingabezeile + ausklappbarer Hinweis */
  .k-info-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 17px; height: 17px; padding: 0; margin-left: 0.15rem; vertical-align: -3px;
    flex-shrink: 0; background: none; border: 1px solid var(--border-strong); border-radius: 50%;
    color: var(--text-tertiary); cursor: pointer; line-height: 0;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .k-info-btn:hover, .k-info-btn.open { color: var(--color-primary); border-color: var(--color-primary); }
  .k-info-btn.open { background: var(--color-primary-soft); }
  .k-info-btn:focus-visible { outline: none; box-shadow: 0 0 0 3px var(--color-primary-soft); }
  .k-info-btn svg { width: 11px; height: 11px; }
  .k-field-hint {
    margin: 0.35rem 0 0.4rem;
    padding: 0.55rem 0.75rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 0.83rem; line-height: 1.5; color: var(--text-secondary);
  }

  /* Ergebnis (Station 7) */
  .k-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .k-actions .ais-btn { width: auto; flex: 1 1 auto; }
  .k-nachwuerzen { margin-top: 1.6rem; padding-top: 1.2rem; border-top: 1px solid var(--border); }
  .kueche-sub2 { font-size: 0.72rem; color: var(--text-tertiary); font-weight: 500; }

  /* Beispiel-Button im Schritt-Kopf (immer sichtbar, öffnet das Erklär-Modal) */
  .k-example-link {
    display: inline-flex; align-items: center; gap: 0.4rem;
    margin-top: 0.8rem;
    padding: 0.35rem 0.85rem;
    background: none; border: 1px solid var(--border-strong); border-radius: var(--radius-pill);
    font: inherit; font-size: 0.82rem; font-weight: 600; color: var(--text-secondary);
    cursor: pointer; transition: color 0.15s, border-color 0.15s;
  }
  .k-example-link:hover { color: var(--color-primary); border-color: var(--color-primary); }
  .k-example-link:focus-visible { outline: none; box-shadow: 0 0 0 3px var(--color-primary-soft); }
  .k-example-link svg { width: 15px; height: 15px; flex-shrink: 0; }

  /* ===== Erklär-Modal „So entsteht ein Prompt" ===== */
  .modal-content.k-ex { max-width: 720px; }
  .k-ex-scenario {
    margin: 0.2rem 0 0; padding: 0.75rem 0.95rem;
    background: var(--color-primary-soft); border-radius: var(--radius);
    font-size: 0.94rem; line-height: 1.55; color: var(--color-dark);
  }
  .k-ex-rows { list-style: none; margin: 1.1rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 0.85rem; }
  .k-ex-row {
    padding: 0.9rem 1rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .k-ex-in { display: flex; flex-direction: column; align-items: flex-start; gap: 0.35rem; }
  .k-ex-step { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-primary-hover); }
  .k-ex-pick {
    padding: 0.28rem 0.75rem;
    background: var(--surface); border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill); font-size: 0.9rem; font-weight: 600; color: var(--color-dark);
  }
  .k-ex-why { align-self: stretch; margin: 0.15rem 0 0; font-size: 0.86rem; line-height: 1.5; color: var(--text-secondary); }
  .k-ex-arrow { display: block; margin: 0.55rem 0 0.45rem; color: var(--text-tertiary); line-height: 0; }
  .k-ex-arrow svg { width: 18px; height: 18px; }
  .k-ex-out {
    white-space: pre-wrap; word-wrap: break-word;
    font-family: "SFMono-Regular", Menlo, Monaco, Consolas, monospace;
    font-size: 0.82rem; line-height: 1.55; color: var(--text);
    background: rgba(0, 0, 0, 0.16); border-radius: var(--radius-sm); padding: 0.6rem 0.7rem;
  }
  .k-ex-out strong { color: var(--color-primary-hover); font-weight: 700; }
  .k-ex-full { margin-top: 1.3rem; padding-top: 1.1rem; border-top: 1px solid var(--border); }
  .k-ex-full-label { margin: 0 0 0.55rem; font-size: 0.88rem; font-weight: 600; color: var(--color-dark); }
  .k-ex-full-text {
    margin: 0; white-space: pre-wrap; word-wrap: break-word;
    font-family: "SFMono-Regular", Menlo, Monaco, Consolas, monospace;
    font-size: 0.82rem; line-height: 1.6; color: var(--text);
    background: rgba(0, 0, 0, 0.28); border: 1px solid var(--border);
    border-radius: var(--radius-sm); padding: 0.85rem 0.9rem;
  }
  .k-ex-foot { margin-top: 1.4rem; display: flex; justify-content: flex-end; }
  .k-ex-foot .ais-btn { width: auto; }

  /* ===== Live-Vorschau ===== */
  .kueche-preview {
    position: sticky; top: 1rem;
    display: flex; flex-direction: column;
    max-height: calc(100vh - 2rem);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }
  .k-preview-head { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding: 0.7rem 0.9rem; border-bottom: 1px solid var(--border); }
  .k-preview-toggle { display: flex; align-items: center; gap: 0.4rem; background: none; border: none; font: inherit; cursor: pointer; color: var(--color-dark); padding: 0; }
  .k-preview-title { font-family: var(--font-display); font-weight: 600; font-size: 0.98rem; }
  .k-preview-title small { color: var(--text-tertiary); font-weight: 500; font-size: 0.72rem; margin-left: 0.3rem; }
  .k-preview-caret { display: none; width: 8px; height: 8px; border-right: 2px solid var(--text-secondary); border-bottom: 2px solid var(--text-secondary); transform: rotate(-135deg); transition: transform 0.18s var(--ease-smooth); }
  .k-preview-copy {
    background: rgba(255,255,255,0.045); color: var(--text);
    border: none; border-radius: var(--radius-pill);
    padding: 0.35rem 0.8rem; font: inherit; font-size: 0.78rem; font-weight: 600; cursor: pointer;
    transition: all 0.15s var(--ease-smooth);
  }
  .k-preview-copy:hover { background: var(--color-primary); color: var(--on-primary); }
  .k-preview-copy.copied { background: #198754; color: #fff; }
  .k-preview-body { padding: 0.7rem 0.9rem 0.9rem; overflow-y: auto; }
  .k-preview-empty { margin: 0.2rem 0; font-size: 0.85rem; color: var(--text-tertiary); line-height: 1.5; }
  .k-preview-section {
    white-space: pre-wrap; word-wrap: break-word;
    font-family: "SFMono-Regular", Menlo, Monaco, Consolas, monospace;
    font-size: 0.8rem; line-height: 1.55; color: var(--text);
    padding: 0.25rem 0.4rem; border-radius: var(--radius-sm);
  }
  .k-preview-section + .k-preview-section { margin-top: 0.5rem; }
  @keyframes kFlash { 0% { background: var(--color-primary-soft); } 100% { background: transparent; } }
  .k-flash { animation: kFlash 1.2s var(--ease-out); }

  /* ===== Mobil: Vorschau als einklappbares Panel unten ===== */
  @media (max-width: 900px) {
    .kueche-layout { grid-template-columns: 1fr; padding-bottom: 3.5rem; }
    .k-reset-btn { position: static; margin: 0 0 0.9rem; }
    .kueche-preview {
      position: fixed; left: 0; right: 0; bottom: 0; top: auto;
      z-index: 30; max-height: 70vh;
      border: none; border-top: 1.5px solid var(--border-strong);
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
      box-shadow: var(--shadow-lg);
    }
    .k-preview-caret { display: inline-block; }
    .kueche-preview[data-open] .k-preview-caret { transform: rotate(45deg); }
    .kueche-preview:not([data-open]) .k-preview-body { display: none; }
    .kueche-preview:not([data-open]) .k-preview-copy { display: none; }
  }
  @media (min-width: 901px) {
    .k-preview-body { display: block !important; }
  }
</style>

<script>
  import { assembleParts, assemblePrompt } from '../data/kueche/schema.js';
  import { ICONS, REZEPT_ICON } from '../data/icons.js';
  import rezepteJson from '../data/kueche/rezepte.json';
  import rollenJson from '../data/kueche/rollen.json';
  import formateJson from '../data/kueche/formate.json';
  import tabusJson from '../data/kueche/tabus.json';
  import { openInTool, copyToClipboard, TOOL_LABEL } from '../scripts/kanaele.js';

  const catalog = {
    rezepte: rezepteJson.rezepte,
    rollen: rollenJson.rollen,
    formate: formateJson,
    tabus: tabusJson.tabus,
  };

  // ===== Grundeinstellungen (Station 0, localStorage) =====
  const SETTINGS_KEY = 'pp_kueche_settings';
  const DEFAULT_SETTINGS = { schulform: '', fach: '', klassenstufe: '', zielTool: 'ais' };
  function loadSettings() {
    try { return { ...DEFAULT_SETTINGS, ...(JSON.parse(localStorage.getItem(SETTINGS_KEY) || '{}')) }; }
    catch (e) { return { ...DEFAULT_SETTINGS }; }
  }
  function saveSettings(s) { try { localStorage.setItem(SETTINGS_KEY, JSON.stringify(s)); } catch (e) { /* egal */ } }

  // ===== Zustand =====
  const state = {
    settings: loadSettings(),
    rezeptId: '', thema: '', material: '',
    gaeste: { vorwissen: '', sprachniveau: '', besonderheiten: [] },
    rolleId: '', rolleFreitext: '',
    format: '', laenge: '', ton: '',
    tabus: [], tabusFreitext: '',
  };

  const STATIONS = [
    { label: 'Grundeinstellungen', iconSlug: 'zahnrad', pflicht: false, render: renderSettings,
      guide: 'Stell einmal ein, für welche Klasse und welches Fach du meistens arbeitest – das steckt dann automatisch in jedem Prompt. Beim nächsten Mal ist es schon gemerkt; Felder darfst du auch leer lassen.' },
    { label: 'Was soll passieren?', iconSlug: 'klemmbrett', pflicht: true, render: renderRezept,
      guide: 'Womit soll die KI dir helfen? Tipp auf eine Aufgabe – oder schau dir erst ein Beispiel an.' },
    { label: 'Worum geht’s?', iconSlug: 'korb', pflicht: true, render: renderZutaten,
      guide: 'Worum geht es konkret? Je genauer das Thema, desto besser das Ergebnis.' },
    { label: 'Für wen?', iconSlug: 'personen', pflicht: false, render: renderFuerWen,
      guide: 'Für welche Lerngruppe schreibst du? Das hilft der KI, Niveau und Sprache zu treffen. Diesen Schritt kannst du auch überspringen.' },
    { label: 'Wer soll antworten?', iconSlug: 'sprechblase', pflicht: false, render: renderRolle,
      guide: 'In welcher Rolle soll die KI antworten? Wir schlagen etwas Passendes vor – ändern kannst du es jederzeit.' },
    { label: 'Wie soll es rauskommen?', iconSlug: 'stift', pflicht: false, render: renderFormat,
      guide: 'Format, Länge und Ton der Antwort – nur wenn du etwas Bestimmtes brauchst. Sonst einfach weiter.' },
    { label: 'Was die KI vermeiden soll', iconSlug: 'verboten', pflicht: false, render: renderTabus,
      guide: 'Gibt es No-Gos? Wähl aus oder schreib es dazu. Optional.' },
    { label: 'Fertig', iconSlug: 'haken', pflicht: false, render: renderErgebnis,
      guide: 'Geschafft! Dein Prompt ist fertig – so nutzt du ihn.' },
  ];
  const LAST = STATIONS.length - 1;
  let current = 0;
  let maxVisited = 0;
  const hasSettings = () => !!(state.settings.schulform || state.settings.fach || state.settings.klassenstufe);

  // ===== Element-Refs =====
  const bodyEl = document.getElementById('k-body');
  const labelEl = document.getElementById('k-label');
  const iconEl = document.getElementById('k-icon');
  const pflichtEl = document.getElementById('k-pflicht');
  const stepEl = document.getElementById('k-step');
  const guideEl = document.getElementById('k-guide');
  const progressEl = document.getElementById('k-progress');
  const backBtn = document.getElementById('k-back');
  const nextBtn = document.getElementById('k-next');
  const resetBtn = document.getElementById('k-reset');
  const summaryEl = document.getElementById('k-settings-summary');
  const announceEl = document.getElementById('k-announce');
  // Vorschau
  const preview = document.getElementById('k-preview');
  const previewToggle = document.getElementById('k-preview-toggle');
  const previewCopy = document.getElementById('k-preview-copy');
  const previewSections = document.getElementById('k-preview-sections');
  const previewEmpty = document.getElementById('k-preview-empty');

  // ===== kleine DOM-Helfer =====
  function el(tag, cls, txt) { const e = document.createElement(tag); if (cls) e.className = cls; if (txt != null) e.textContent = txt; return e; }
  function toggleArr(arr, v) { const i = arr.indexOf(v); if (i >= 0) arr.splice(i, 1); else arr.push(v); }
  function chip(label, selected, onClick) {
    const b = el('button', 'wz-chip' + (selected ? ' selected' : ''), label);
    b.type = 'button';
    b.setAttribute('aria-pressed', selected ? 'true' : 'false');
    b.addEventListener('click', onClick);
    return b;
  }
  // Kleiner Info-Button, der an ein Label gehängt wird und einen Hinweis ein-/ausklappt.
  const INFO_ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 16v-4M12 8h.01"/></svg>';
  function infoToggle(labelEl, infoText) {
    const hint = el('p', 'k-field-hint'); hint.hidden = true; hint.textContent = infoText;
    const btn = el('button', 'k-info-btn'); btn.type = 'button';
    btn.innerHTML = INFO_ICON;
    btn.title = 'Was bringt das?';
    btn.setAttribute('aria-label', 'Erklärung ein-/ausblenden');
    btn.setAttribute('aria-expanded', 'false');
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const open = hint.hidden; hint.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      btn.classList.toggle('open', open);
    });
    labelEl.append(document.createTextNode(' '), btn);
    return hint;
  }
  function singleChipField(label, items, getVal, setVal, info) {
    const fs = el('div', 'kueche-fieldset');
    const lab = el('span', 'kueche-fieldlabel', label);
    fs.appendChild(lab);
    if (info) fs.appendChild(infoToggle(lab, info));
    const wrap = el('div', 'wz-chips');
    items.forEach((it) => {
      const b = chip(it.label, getVal() === it.id, () => {
        setVal(it.id);
        wrap.querySelectorAll('.wz-chip').forEach((c) => { c.classList.remove('selected'); c.setAttribute('aria-pressed', 'false'); });
        b.classList.add('selected'); b.setAttribute('aria-pressed', 'true');
      });
      wrap.appendChild(b);
    });
    fs.appendChild(wrap);
    return fs;
  }
  function textField(label, placeholder, value, onInput, long, info) {
    const l = el('label', 'builder-field');
    const lab = el('span', null, label);
    l.appendChild(lab);
    if (info) l.appendChild(infoToggle(lab, info));
    const input = el(long ? 'textarea' : 'input');
    if (long) input.rows = 6; else input.type = 'text';
    input.placeholder = placeholder || '';
    input.value = value || '';
    input.autocomplete = 'off';
    input.addEventListener('input', () => onInput(input.value));
    l.appendChild(input);
    l._input = input;
    return l;
  }

  // ===== Rezept-Auswahl wendet Defaults an =====
  function selectRezept(id) {
    state.rezeptId = id;
    const r = catalog.rezepte.find((x) => x.id === id);
    const d = (r && r.defaults) || {};
    const refined = (rollenJson.nachSchulform || {})[state.settings.schulform];
    state.rolleId = refined || d.rolleId || '';
    state.rolleFreitext = '';
    state.format = d.format || '';
    state.laenge = d.laenge || '';
    state.ton = d.ton || '';
    state.tabus = [...(d.tabus || [])];
  }

  // Setzt Inhalt zurück (Grundeinstellungen bleiben) – für "selbst anfangen".
  function resetContent() {
    state.rezeptId = ''; state.thema = ''; state.material = '';
    state.gaeste = { vorwissen: '', sprachniveau: '', besonderheiten: [] };
    state.rolleId = ''; state.rolleFreitext = '';
    state.format = ''; state.laenge = ''; state.ton = '';
    state.tabus = []; state.tabusFreitext = '';
    prevParts = new Map();
  }

  // Alles zurücksetzen – inklusive Grundeinstellungen – "Neu anfangen".
  function resetAll() {
    resetContent();
    state.settings = { ...DEFAULT_SETTINGS };
    saveSettings(state.settings);
    maxVisited = 0;
    current = 0;
    renderStation();
  }

  // ===== Stationen =====
  function renderRezept() {
    const grid = el('div', 'k-rezept-grid');
    catalog.rezepte.forEach((r) => {
      const card = el('button', 'k-rezept-card' + (state.rezeptId === r.id ? ' selected' : ''));
      card.type = 'button';
      card.setAttribute('aria-pressed', state.rezeptId === r.id ? 'true' : 'false');
      const ic = el('span', 'k-rezept-icon'); ic.setAttribute('aria-hidden', 'true'); ic.innerHTML = ICONS[REZEPT_ICON[r.id]] || '';
      card.append(ic, el('span', 'k-rezept-label', r.label), el('span', 'k-rezept-desc', r.beschreibung));
      card.addEventListener('click', () => { selectRezept(r.id); renderStation(); });
      grid.appendChild(card);
    });
    bodyEl.appendChild(grid);
  }

  function renderSettings() {
    const grid = el('div', 'kueche-settings-grid');
    const mk = (key, label, ph, isSelect, info) => {
      const l = el('label', 'builder-field');
      const lab = el('span', null, label);
      l.appendChild(lab);
      let inp;
      if (isSelect) {
        inp = el('select');
        const cur = state.settings.zielTool == null ? 'ais' : state.settings.zielTool;
        [['', 'Keine Angabe'], ['ais', 'AIS.chat'], ['chatgpt', 'ChatGPT'], ['claude', 'Claude'], ['copilot', 'Copilot']].forEach(([v, t]) => {
          const o = el('option', null, t); o.value = v;
          if (cur === v) o.selected = true;
          inp.appendChild(o);
        });
      } else {
        inp = el('input'); inp.type = 'text'; inp.placeholder = ph; inp.value = state.settings[key] || ''; inp.autocomplete = 'off';
      }
      const upd = () => { state.settings[key] = inp.value; saveSettings(state.settings); };
      inp.addEventListener('input', upd);
      inp.addEventListener('change', upd);
      if (info) l.appendChild(infoToggle(lab, info));
      l.appendChild(inp);
      grid.appendChild(l);
    };
    mk('schulform', 'Schulform', 'z. B. Gymnasium', false, 'Zum Beispiel Grundschule, Gymnasium oder Berufsschule. Damit trifft die KI automatisch das passende Niveau – du musst es später im Prompt nicht mehr erwähnen.');
    mk('fach', 'Fach', 'z. B. Deutsch', false, 'Dein Unterrichtsfach, z. B. Deutsch, Mathe oder Biologie. Die KI richtet Beispiele, Begriffe und Fachsprache danach aus.');
    mk('klassenstufe', 'Klassenstufe', 'z. B. 7', false, 'Die Jahrgangsstufe, z. B. „7". Sie steuert, wie anspruchsvoll und ausführlich die Antwort wird.');
    mk('zielTool', 'Ziel-KI-Tool', '', true, 'Das KI-Tool, mit dem du arbeitest (z. B. AIS.chat oder ChatGPT). Am Ende bekommst du einen Button, der den fertigen Prompt direkt dort öffnet. „Keine Angabe" ist auch okay – dann kopierst du ihn einfach.');
    bodyEl.appendChild(grid);
  }

  function renderZutaten() {
    const t = textField('Thema oder Anlass', 'z. B. Photosynthese, Elternabend, Bruchrechnen', state.thema, (v) => { state.thema = v; updateNav(); }, false,
      'Worum geht es konkret? Je genauer, desto besser: statt „Wasser" lieber „der Wasserkreislauf" oder „Elternabend zur Klassenfahrt". Ein, zwei Stichworte reichen schon.');
    bodyEl.appendChild(t);

    const rz = catalog.rezepte.find((r) => r.id === state.rezeptId);
    if (rz && rz.beispiele && rz.beispiele.length) {
      const ex = el('p', 'k-thema-ex');
      ex.appendChild(el('span', 'k-thema-ex-label', 'Beispiele zum Antippen:'));
      rz.beispiele.forEach((b) => {
        const c = el('button', 'k-thema-chip', b); c.type = 'button';
        c.addEventListener('click', () => { state.thema = b; t._input.value = b; updateNav(); renderPreview(); });
        ex.appendChild(c);
      });
      bodyEl.appendChild(ex);
    }

    const m = textField('Vorhandenes Material einfügen (optional)', 'Text, Aufgabenstellung oder Schüler:innentext hier einfügen …', state.material, (v) => { state.material = v; }, true,
      'Hast du schon einen Text, eine Aufgabe oder einen Schüler:innentext? Füg ihn hier ein – die KI arbeitet dann direkt damit, statt sich etwas Eigenes auszudenken. (Bitte keine echten Namen.)');
    bodyEl.appendChild(m);
    setTimeout(() => t._input.focus(), 40);
  }

  function buildGaeste(parent) {
    const parts = [];
    if (state.settings.fach) parts.push('Fach ' + state.settings.fach);
    if (state.settings.schulform) parts.push(state.settings.schulform);
    if (state.settings.klassenstufe) parts.push('Klasse ' + state.settings.klassenstufe);
    const rem = el('p', 'kueche-hint');
    rem.append(document.createTextNode(parts.length ? 'Aus deinen Grundeinstellungen: ' + parts.join(', ') + '. ' : 'Noch keine Grundeinstellungen gesetzt. '));
    const open = el('button', 'k-linklike', parts.length ? 'ändern' : 'Grundeinstellungen ausfüllen');
    open.type = 'button';
    open.addEventListener('click', () => goTo(0));
    rem.appendChild(open);
    parent.appendChild(rem);

    parent.appendChild(textField('Vorwissen', 'Was ist schon bekannt?', state.gaeste.vorwissen, (v) => { state.gaeste.vorwissen = v; }, false,
      'Was kennt die Lerngruppe schon? Z. B. „Bruchrechnen ist bekannt". Die KI baut darauf auf und wiederholt Bekanntes nicht unnötig.'));
    parent.appendChild(textField('Sprachniveau', 'z. B. einfache Sprache, Fachsprache okay', state.gaeste.sprachniveau, (v) => { state.gaeste.sprachniveau = v; }, false,
      'Wie einfach soll die Sprache sein? Z. B. „einfache Sprache" oder „Fachsprache ist okay". Besonders hilfreich bei jüngeren Klassen oder hohem DaZ-Anteil.'));

    const fs = el('div', 'kueche-fieldset');
    const besLab = el('span', 'kueche-fieldlabel', 'Besonderheiten (Mehrfachauswahl)');
    fs.appendChild(besLab);
    fs.appendChild(infoToggle(besLab, 'Besonderheiten der Gruppe, z. B. ein hoher DaZ-Anteil oder Nachteilsausgleich. Die KI berücksichtigt das bei Aufgaben, Beispielen und Formulierungen.'));
    const wrap = el('div', 'wz-chips');
    ['DaZ / Deutsch als Zweitsprache', 'Nachteilsausgleich', 'heterogene Gruppe'].forEach((b) => {
      wrap.appendChild(chip(b, state.gaeste.besonderheiten.includes(b), (e) => {
        toggleArr(state.gaeste.besonderheiten, b);
        const on = state.gaeste.besonderheiten.includes(b);
        e.currentTarget.classList.toggle('selected', on);
        e.currentTarget.setAttribute('aria-pressed', on ? 'true' : 'false');
      }));
    });
    fs.appendChild(wrap);
    parent.appendChild(fs);
  }

  function buildKoechin(parent) {
    parent.appendChild(el('p', 'kueche-hint', 'Vorschlag passend zu deiner Auswahl. Du kannst ihn ändern oder eine eigene Rolle schreiben.'));
    const l = el('label', 'builder-field');
    const rolleLab = el('span', null, 'Rolle der KI');
    l.appendChild(rolleLab);
    l.appendChild(infoToggle(rolleLab, 'In welcher Rolle soll die KI antworten? Eine „geduldige Erklärerin" klingt ganz anders als ein „strenger Prüfer" – die Rolle prägt Ton und Herangehensweise. Wir schlagen etwas Passendes vor, du kannst aber auch eine eigene Rolle schreiben.'));
    const sel = el('select');
    catalog.rollen.forEach((r) => {
      const o = el('option', null, r.label); o.value = r.id;
      if (!state.rolleFreitext && (state.rolleId || '') === r.id) o.selected = true;
      sel.appendChild(o);
    });
    const oFree = el('option', null, 'Eigene Rolle …'); oFree.value = '__frei';
    if (state.rolleFreitext) oFree.selected = true;
    sel.appendChild(oFree);
    l.appendChild(sel);

    const free = el('input');
    free.type = 'text'; free.placeholder = 'Eigene Rolle beschreiben, z. B. „strenge:r Prüfer:in“';
    free.value = state.rolleFreitext || ''; free.hidden = !state.rolleFreitext;
    free.style.marginTop = '0.5rem';
    sel.addEventListener('change', () => {
      if (sel.value === '__frei') { free.hidden = false; state.rolleId = ''; setTimeout(() => free.focus(), 30); }
      else { free.hidden = true; state.rolleFreitext = ''; state.rolleId = sel.value; }
      renderPreview();
    });
    free.addEventListener('input', () => { state.rolleFreitext = free.value; });
    l.appendChild(free);
    parent.appendChild(l);
  }

  function buildAnrichten(parent) {
    parent.appendChild(singleChipField('Format', catalog.formate.formate, () => state.format, (id) => { state.format = id; },
      'Die Form der Antwort: Fließtext, Tabelle, Stichpunkte oder Arbeitsblatt – je nachdem, was du im Unterricht direkt gebrauchen kannst.'));
    parent.appendChild(singleChipField('Länge', catalog.formate.laengen, () => state.laenge, (id) => { state.laenge = id; },
      'Wie umfangreich soll es werden – kurz und knapp für einen schnellen Überblick oder ausführlich mit Beispielen und Erklärungen?'));
    parent.appendChild(singleChipField('Ton', catalog.formate.toene, () => state.ton, (id) => { state.ton = id; },
      'Der Tonfall der Antwort, z. B. sachlich, locker oder ermutigend. Passt die Sprache an deine Lerngruppe an.'));
  }

  function buildAllergien(parent) {
    const fs = el('div', 'kueche-fieldset');
    const tabuLab = el('span', 'kueche-fieldlabel', 'Was die KI vermeiden soll (Mehrfachauswahl)');
    fs.appendChild(tabuLab);
    fs.appendChild(infoToggle(tabuLab, 'Was soll die KI weglassen? Z. B. keine Fachbegriffe ohne Erklärung, keine Namen oder keine Rückfragen. Ein Häkchen genügt.'));
    const wrap = el('div', 'wz-chips');
    catalog.tabus.forEach((t) => {
      wrap.appendChild(chip(t.label, state.tabus.includes(t.id), (e) => {
        toggleArr(state.tabus, t.id);
        const on = state.tabus.includes(t.id);
        e.currentTarget.classList.toggle('selected', on);
        e.currentTarget.setAttribute('aria-pressed', on ? 'true' : 'false');
      }));
    });
    fs.appendChild(wrap);
    parent.appendChild(fs);
    parent.appendChild(textField('Noch etwas, das nicht sein soll?', 'z. B. keine Fremdwörter', state.tabusFreitext, (v) => { state.tabusFreitext = v; }, false,
      'Eigene No-Gos, die nicht in der Liste stehen – z. B. „keine Fremdwörter", „nicht duzen" oder „keine langen Sätze".'));
  }

  // Verfeinerungs-Schritte im normalen Ablauf (füllen den Stations-Body)
  function renderFuerWen() { buildGaeste(bodyEl); }
  function renderRolle()   { buildKoechin(bodyEl); }
  function renderFormat()  { buildAnrichten(bodyEl); }
  function renderTabus()   { buildAllergien(bodyEl); }

  function renderErgebnis() {
    const tool = state.settings.zielTool || '';
    const hasTool = !!tool && !!TOOL_LABEL[tool];
    const toolName = hasTool ? TOOL_LABEL[tool] : '';

    const usage = el('ol', 'k-usage');
    if (hasTool) {
      usage.appendChild(el('li', null, 'Unten auf „Kopieren & in ' + toolName + ' öffnen" tippen.'));
      usage.appendChild(el('li', null, 'Im neuen Tab den Prompt mit Strg+V einfügen (am Mac: Cmd+V).'));
    } else {
      usage.appendChild(el('li', null, 'Unten auf „Prompt kopieren" tippen.'));
      usage.appendChild(el('li', null, 'In deinem KI-Tool mit Strg+V einfügen (am Mac: Cmd+V).'));
    }
    usage.appendChild(el('li', null, 'Abschicken – die KI macht den Rest.'));
    bodyEl.appendChild(usage);

    const actions = el('div', 'k-actions');
    if (hasTool) {
      const openBtn = el('button', 'ais-btn'); openBtn.type = 'button';
      openBtn.textContent = 'Kopieren & in ' + toolName + ' öffnen';
      const copyBtn = el('button', 'secondary-btn', 'Nur kopieren'); copyBtn.type = 'button';
      actions.append(openBtn, copyBtn);
      bodyEl.appendChild(actions);

      const hint = el('p', 'ais-hint'); hint.hidden = true; hint.setAttribute('aria-live', 'polite');
      bodyEl.appendChild(hint);

      openBtn.addEventListener('click', async () => {
        const res = await openInTool(tool, assemblePrompt(state, catalog));
        hint.hidden = false;
        hint.className = 'ais-hint' + (res.ok ? '' : ' ais-hint-error');
        hint.textContent = res.ok
          ? '✓ Kopiert. ' + (TOOL_LABEL[tool] || 'Das Tool') + ' öffnet sich in einem neuen Tab. Dort den Prompt mit Strg+V einfügen (am Mac: Cmd+V).'
          : '⚠ Kopieren hat nicht geklappt. Markiere den Text in der Vorschau und kopiere ihn mit Strg+C.';
      });
      copyBtn.addEventListener('click', async () => {
        const ok = await copyToClipboard(assemblePrompt(state, catalog));
        copyBtn.textContent = ok ? '✓ Kopiert' : '⚠ Fehler';
        setTimeout(() => { copyBtn.textContent = 'Nur kopieren'; }, 1500);
      });
    } else {
      const copyBtn = el('button', 'ais-btn', 'Prompt kopieren'); copyBtn.type = 'button';
      actions.append(copyBtn);
      bodyEl.appendChild(actions);
      copyBtn.addEventListener('click', async () => {
        const ok = await copyToClipboard(assemblePrompt(state, catalog));
        copyBtn.textContent = ok ? '✓ Kopiert' : '⚠ Fehler';
        setTimeout(() => { copyBtn.textContent = 'Prompt kopieren'; }, 1500);
      });
    }

    // Antwort nachschärfen: schnelle Zurufe zum Nachfassen im selben Chat
    const na = el('div', 'k-nachwuerzen');
    na.appendChild(el('h3', 'kueche-fieldlabel', 'Antwort noch nicht perfekt?'));
    na.appendChild(el('p', 'kueche-hint', 'Tippe auf einen Zuruf – er wird kopiert. Füg ihn im selben Chat ein, dann bessert die KI nach.'));
    const chips = el('div', 'nachfass-chips');
    ['Mach es kürzer.', 'Formuliere es einfacher.', 'Gib mir eine zweite Variante.', 'Ändere den Ton.'].forEach((txt) => {
      const b = el('button', 'nachfass-chip', txt); b.type = 'button';
      b.addEventListener('click', async () => {
        const ok = await copyToClipboard(txt);
        const prev = b.textContent;
        b.classList.toggle('copied', ok);
        b.textContent = ok ? '✓ Kopiert' : '⚠ Fehler';
        clearTimeout(b._t);
        b._t = setTimeout(() => { b.classList.remove('copied'); b.textContent = prev; }, 1400);
      });
      chips.appendChild(b);
    });
    na.appendChild(chips);
    bodyEl.appendChild(na);

    // Auf Mobil die Vorschau öffnen, damit der Prompt sichtbar ist
    openPreview(true);
  }

  // ===== Live-Vorschau =====
  let prevParts = new Map();
  function renderPreview() {
    const parts = assembleParts(state, catalog);
    previewEmpty.hidden = parts.length > 0;
    previewCopy.hidden = parts.length === 0;
    previewSections.innerHTML = '';
    const next = new Map();
    parts.forEach((p) => {
      next.set(p.key, p.text);
      const div = el('div', 'k-preview-section');
      div.textContent = p.text;
      if (prevParts.get(p.key) !== p.text) div.classList.add('k-flash');
      previewSections.appendChild(div);
    });
    prevParts = next;
  }

  function openPreview(open) {
    if (open) preview.setAttribute('data-open', '');
    else preview.removeAttribute('data-open');
    previewToggle.setAttribute('aria-expanded', String(!!open));
  }
  previewToggle.addEventListener('click', () => openPreview(!preview.hasAttribute('data-open')));
  previewCopy.addEventListener('click', async () => {
    const ok = await copyToClipboard(assemblePrompt(state, catalog));
    previewCopy.classList.toggle('copied', ok);
    const prev = previewCopy.textContent;
    previewCopy.textContent = ok ? '✓ Kopiert' : '⚠ Fehler';
    setTimeout(() => { previewCopy.classList.remove('copied'); previewCopy.textContent = prev; }, 1500);
  });

  // ===== Erklär-Modal: „So entsteht ein Prompt" =====
  // Ein festes, nachvollziehbares Beispiel. Der Prompt-Teil kommt aus dem echten
  // assembleParts(), damit gezeigt wird, was der Baukasten wirklich baut.
  const EXAMPLE_STATE = {
    settings: { schulform: 'Gymnasium', fach: 'Biologie', klassenstufe: '7', zielTool: 'ais' },
    rezeptId: 'erklaeren', thema: 'Photosynthese', material: '',
    gaeste: { vorwissen: 'Zellaufbau grob bekannt', sprachniveau: 'einfache Sprache', besonderheiten: ['DaZ / Deutsch als Zweitsprache'] },
    rolleId: '', rolleFreitext: '',
    format: '', laenge: '', ton: '',
    tabus: [], tabusFreitext: 'keine Fachbegriffe ohne kurze Erklärung',
  };
  const exModal = document.getElementById('k-example-modal');
  const DOWN_ARROW = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>';
  function fmtPart(text) {
    const esc = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    return esc.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  }
  const ctxJoin = (arr) => arr.filter(Boolean).join('. ') + '.';
  let exampleBuilt = false;
  function buildExample() {
    if (exampleBuilt) return;
    const s = EXAMPLE_STATE.settings, g = EXAMPLE_STATE.gaeste;
    const part = {};
    assembleParts(EXAMPLE_STATE, catalog).forEach((p) => { part[p.key] = p.text; });

    // Zeilen in genau der Reihenfolge des Formulars (Schritt 1 → 7). Der Kontext
    // entsteht aus zwei Schritten (1 + 4) – das zeigen wir ehrlich als zwei Zeilen.
    const rows = [
      { step: 'Schritt 1 · Grundeinstellungen', pick: 'Biologie · Gymnasium · Klasse 7',
        why: 'Das stellst du nur einmal ein: Fach, Schulform und Klassenstufe. So weiß die KI, für welche Lerngruppe sie arbeitet – und du musst es nicht bei jedem Prompt wiederholen. Diese Angaben starten den Kontext-Block des Prompts.',
        out: '**Kontext:** ' + ctxJoin(['Fach: ' + s.fach, 'Schulform: ' + s.schulform, 'Klassenstufe: ' + s.klassenstufe]) },
      { step: 'Schritt 2 + 3 · Was soll passieren? + Worum geht’s?', pick: 'Erklären · „Photosynthese"',
        why: 'Das Herzstück: Du wählst, was die KI tun soll (erklären, planen, formulieren …) und wozu genau. Beides zusammen wird zur eigentlichen Aufgabe – dem wichtigsten Satz im Prompt.',
        out: part.aufgabe },
      { step: 'Schritt 4 · Für wen?', pick: 'Vorwissen · einfache Sprache · DaZ-Anteil',
        why: 'Hier beschreibst du die Lerngruppe genauer – Vorwissen, Sprachniveau, Besonderheiten wie ein hoher DaZ-Anteil. Damit trifft die KI Niveau und Wortwahl. Diese Angaben ergänzen denselben Kontext-Block wie Schritt 1.',
        out: '… ergänzt den **Kontext:** ' + ctxJoin(['Vorwissen: ' + g.vorwissen, 'Sprachniveau: ' + g.sprachniveau, 'Besonderheiten: ' + g.besonderheiten.join(', ')]) },
      { step: 'Schritt 5 · Wer soll antworten?', pick: 'geduldige Erklärerin',
        why: 'Du gibst der KI eine Rolle. „Als geduldige Erklärerin" führt zu einer ganz anderen Antwort als etwa „als strenge Prüferin" – die Rolle prägt Ton und Herangehensweise.',
        out: part.rolle },
      { step: 'Schritt 6 · Wie soll es rauskommen?', pick: 'Fließtext · mittlere Länge · einfache Sprache',
        why: 'Die Form der Antwort: Format (Fließtext, Tabelle, Stichpunkte …), Länge und Ton. So bekommst du das Ergebnis gleich in der Gestalt, die du im Unterricht brauchst.',
        out: part.ausgabe },
      { step: 'Schritt 7 · Was die KI vermeiden soll', pick: 'keine Fachbegriffe ohne Erklärung',
        why: 'Zum Schluss die Grenzen: Was soll die KI weglassen? Hier zum Beispiel keine Fachbegriffe ohne kurze Erklärung – wichtig bei einem hohen DaZ-Anteil.',
        out: part.regeln },
    ];

    const rowsEl = document.getElementById('k-ex-rows');
    rows.forEach((r) => {
      if (!r.out) return;
      const row = el('li', 'k-ex-row');
      const inWrap = el('div', 'k-ex-in');
      inWrap.append(el('span', 'k-ex-step', r.step), el('span', 'k-ex-pick', r.pick));
      if (r.why) inWrap.appendChild(el('p', 'k-ex-why', r.why));
      const arrow = el('span', 'k-ex-arrow'); arrow.setAttribute('aria-hidden', 'true'); arrow.innerHTML = DOWN_ARROW;
      const outWrap = el('div', 'k-ex-out'); outWrap.innerHTML = fmtPart(r.out);
      row.append(inWrap, arrow, outWrap);
      rowsEl.appendChild(row);
    });
    document.getElementById('k-ex-full-text').textContent = assemblePrompt(EXAMPLE_STATE, catalog);
    exampleBuilt = true;
  }
  function openExample() {
    buildExample();
    exModal.hidden = false;
    exModal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    setTimeout(() => exModal.querySelector('.icon-btn').focus(), 40);
  }
  function closeExample() {
    exModal.hidden = true;
    exModal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }
  exModal.addEventListener('click', (e) => { if (e.target.closest('[data-ex-close]')) closeExample(); });
  document.getElementById('k-ex-start').addEventListener('click', closeExample);
  document.getElementById('k-example-btn').addEventListener('click', openExample);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !exModal.hidden) closeExample(); });

  // ===== Rendern + Navigation =====
  function goTo(i) {
    if (i < 0 || i > LAST) return;
    current = i;
    if (i > maxVisited) maxVisited = i;
    renderStation();
  }

  function renderStation() {
    const st = STATIONS[current];
    stepEl.textContent = 'Schritt ' + (current + 1) + ' von ' + STATIONS.length;
    labelEl.textContent = st.label;
    iconEl.innerHTML = ICONS[st.iconSlug] || '';
    pflichtEl.textContent = st.pflicht ? 'nötig' : 'optional';
    pflichtEl.className = 'kueche-badge ' + (st.pflicht ? 'is-pflicht' : 'is-optional');
    guideEl.textContent = st.guide || '';

    // Screenreader-Ansage des Schrittwechsels
    announceEl.textContent = 'Schritt ' + (current + 1) + ' von ' + STATIONS.length + ': ' + st.label;
    updateSettingsSummary();

    // Fortschritt: besuchte Stationen sind anspringbar (großzügige Tap-Ziele)
    progressEl.innerHTML = '';
    STATIONS.forEach((s, i) => {
      const hit = el('button', 'k-dot' + (i === current ? ' current' : ''));
      hit.type = 'button';
      hit.setAttribute('aria-label', 'Station ' + (i + 1) + ' von ' + STATIONS.length + ': ' + s.label + (i > maxVisited ? ' (noch nicht verfügbar)' : ''));
      if (i === current) hit.setAttribute('aria-current', 'step');
      hit.disabled = i > maxVisited;
      hit.appendChild(el('span', 'wz-dot' + (i < current ? ' done' : '') + (i === current ? ' active' : '')));
      hit.addEventListener('click', () => goTo(i));
      progressEl.appendChild(hit);
    });

    bodyEl.innerHTML = '';
    st.render();
    updateNav();
    renderPreview();
    bodyEl.focus();
  }

  function updateSettingsSummary() {
    if (current === 0) { summaryEl.hidden = true; return; }
    summaryEl.innerHTML = '';
    const parts = [];
    if (state.settings.fach) parts.push(state.settings.fach);
    if (state.settings.schulform) parts.push(state.settings.schulform);
    if (state.settings.klassenstufe) parts.push('Klasse ' + state.settings.klassenstufe);
    summaryEl.append(document.createTextNode(parts.length ? 'Für ' + parts.join(' · ') + '  ' : 'Ohne Grundeinstellungen  '));
    const a = el('button', 'k-linklike', parts.length ? 'ändern' : 'festlegen');
    a.type = 'button';
    a.addEventListener('click', () => goTo(0));
    summaryEl.appendChild(a);
    summaryEl.hidden = false;
  }

  function updateNav() {
    backBtn.disabled = current === 0;
    const last = current === LAST;
    nextBtn.hidden = last;
    let ok = true;
    if (current === 1) ok = !!state.rezeptId;   // Rezept
    if (current === 2) ok = !!state.thema.trim(); // Zutaten
    nextBtn.disabled = !ok;
    nextBtn.textContent = current === LAST - 1 ? 'Fertig – Prompt zeigen' : 'Weiter';
  }

  backBtn.addEventListener('click', () => { if (current > 0) goTo(current - 1); });
  nextBtn.addEventListener('click', () => { if (current < LAST && !nextBtn.disabled) goTo(current + 1); });
  resetBtn.addEventListener('click', resetAll);

  // Zustandsänderungen im Body -> Vorschau live aktualisieren
  const schedulePreview = () => setTimeout(renderPreview, 0);
  bodyEl.addEventListener('input', schedulePreview);
  bodyEl.addEventListener('click', schedulePreview);
  bodyEl.addEventListener('change', schedulePreview);

  // Vorschau auf Desktop offen, auf Mobil zunächst eingeklappt
  openPreview(window.matchMedia('(min-width: 901px)').matches);
  // Wiederkehr: Grundeinstellungen sind gesetzt -> direkt bei "Aufgabe" starten
  if (hasSettings()) { current = 1; maxVisited = 1; }
  renderStation();
</script>
