---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Eigenen Prompt bauen · Prompt-Profi">
  <a href="/" class="back-link">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;vertical-align:-2px;margin-right:4px;"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
    Startseite
  </a>

  <header class="kueche-head">
    <h1>Eigenen Prompt bauen</h1>
    <p class="kueche-intro">Beantworte ein paar Fragen, daraus baust du dir einen fertigen Prompt. Nur die ersten beiden Schritte sind nötig, der Rest ist Feinschliff.</p>
    <button id="k-settings-toggle" class="secondary-btn" type="button" aria-expanded="false" aria-controls="k-settings">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
      Grundeinstellungen
    </button>
  </header>

  <section id="k-settings" class="kueche-settings" hidden aria-label="Grundeinstellungen (Küche einrichten)">
    <p class="kueche-settings-sub">Einmalig einstellen. Wird auf diesem Gerät gespeichert und in den Prompt übernommen.</p>
    <div class="kueche-settings-grid">
      <label class="builder-field"><span>Schulform</span><input id="set-schulform" type="text" placeholder="z. B. Gymnasium" autocomplete="off" /></label>
      <label class="builder-field"><span>Fach</span><input id="set-fach" type="text" placeholder="z. B. Deutsch" autocomplete="off" /></label>
      <label class="builder-field"><span>Klassenstufe</span><input id="set-klassenstufe" type="text" placeholder="z. B. 7" autocomplete="off" /></label>
      <label class="builder-field"><span>Ziel-KI-Tool</span>
        <select id="set-tool">
          <option value="ais">AIS.chat</option>
          <option value="chatgpt">ChatGPT</option>
          <option value="claude">Claude</option>
          <option value="copilot">Copilot</option>
        </select>
      </label>
    </div>
  </section>

  <div class="kueche-flow">
    <div class="wz-dots kueche-progress" id="k-progress" aria-hidden="true"></div>
    <div class="kueche-station-head">
      <h2 id="k-label"></h2>
      <span class="kueche-sub"><span id="k-icon" aria-hidden="true"></span> <span id="k-kueche"></span> <span id="k-pflicht"></span></span>
    </div>
    <div id="k-body" class="kueche-body" tabindex="-1"></div>
    <div class="kueche-nav">
      <button id="k-back" class="wz-back" type="button">Zurück</button>
      <button id="k-next" class="wz-next" type="button">Weiter</button>
    </div>
  </div>

  <noscript>
    <p style="margin-top:1.5rem">Dieser Baukasten braucht JavaScript. <a href="/tool">Zu den fertigen Prompts →</a></p>
  </noscript>
</Layout>

<style is:global>
  .kueche-head { margin-bottom: 1.5rem; }
  .kueche-head h1 {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 5vw, 2.8rem);
    font-weight: 700;
    color: var(--color-dark);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0.4rem 0 0.6rem;
  }
  .kueche-intro { margin: 0 0 1.1rem; max-width: 640px; font-size: 1.03rem; line-height: 1.6; color: var(--text-secondary); }

  .kueche-settings {
    margin: 0 0 1.75rem;
    padding: 1.1rem 1.25rem 1.25rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .kueche-settings-sub { margin: 0 0 0.9rem; font-size: 0.85rem; color: var(--text-secondary); }
  .kueche-settings-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.8rem; }

  .builder-field select {
    padding: 0.45rem 0.65rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: 0.9rem;
    background: var(--surface);
    color: var(--text);
    width: 100%;
    margin-top: 0.1rem;
  }
  .builder-field select:focus { outline: none; border-color: var(--color-primary); box-shadow: 0 0 0 3px var(--color-primary-soft); }

  .kueche-flow {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 1.5rem 1.5rem 1.4rem;
    box-shadow: var(--shadow-sm);
  }
  .kueche-progress { margin-bottom: 1.2rem; }

  .kueche-station-head { margin-bottom: 1.1rem; }
  .kueche-station-head h2 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-dark);
    line-height: 1.2;
    margin: 0 0 0.25rem;
  }
  .kueche-sub { font-size: 0.82rem; color: var(--text-tertiary); }
  .kueche-badge {
    display: inline-block;
    margin-left: 0.35rem;
    padding: 0.05rem 0.5rem;
    border-radius: var(--radius-pill);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .kueche-badge.is-pflicht  { background: var(--color-primary-soft); color: var(--color-primary-hover); }
  .kueche-badge.is-optional { background: var(--bg-secondary); color: var(--text-tertiary); }

  .kueche-body { outline: none; }
  .kueche-body > * + * { margin-top: 0.9rem; }

  .kueche-nav { display: flex; justify-content: space-between; gap: 0.75rem; margin-top: 1.4rem; }

  /* Rezept-Auswahl (Station 1) */
  .k-rezept-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 0.7rem; }
  .k-rezept-card {
    display: flex; flex-direction: column; gap: 0.2rem;
    text-align: left;
    background: var(--surface);
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius);
    padding: 0.85rem 0.95rem;
    cursor: pointer;
    font: inherit;
    transition: border-color 0.15s var(--ease-smooth), box-shadow 0.15s, transform 0.15s;
  }
  .k-rezept-card:hover { border-color: var(--color-primary); transform: translateY(-2px); box-shadow: var(--shadow-sm); }
  .k-rezept-card:focus-visible { outline: none; box-shadow: 0 0 0 3px var(--color-primary-soft); }
  .k-rezept-card.selected { border-color: var(--color-primary); background: var(--color-primary-soft); }
  .k-rezept-icon { font-size: 1.4rem; line-height: 1; }
  .k-rezept-label { font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; color: var(--color-dark); }
  .k-rezept-desc { font-size: 0.82rem; color: var(--text-secondary); line-height: 1.4; }

  /* Feld-Gruppen (Chips) */
  .kueche-fieldset + .kueche-fieldset { margin-top: 1rem; }
  .kueche-fieldlabel { display: block; font-size: 0.85rem; font-weight: 600; color: var(--color-dark); margin-bottom: 0.45rem; }
  .kueche-hint { font-size: 0.82rem; color: var(--text-secondary); line-height: 1.5; }
  .k-linklike { background: none; border: none; padding: 0; font: inherit; color: var(--color-primary); cursor: pointer; text-decoration: underline; }
  .k-linklike:hover { color: var(--color-primary-hover); }

  /* Ergebnis (Station 7) */
  .k-prompt {
    background: var(--bg-tertiary);
    border: none;
    padding: 1.1rem;
    border-radius: var(--radius);
    font-family: "SFMono-Regular", Menlo, Monaco, Consolas, monospace;
    font-size: 0.85rem;
    line-height: 1.6;
    white-space: pre-wrap;
    word-wrap: break-word;
    margin: 0 0 0.9rem;
    max-height: 420px;
    overflow-y: auto;
    color: var(--text);
  }
  .k-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .k-actions .ais-btn { width: auto; flex: 1 1 auto; }
  .k-nachwuerzen { margin-top: 1.6rem; padding-top: 1.2rem; border-top: 1px solid var(--border); }
  .kueche-sub2 { font-size: 0.72rem; color: var(--text-tertiary); font-weight: 500; }

  @media (max-width: 560px) {
    .kueche-flow { padding: 1.15rem; }
    .k-actions .ais-btn { flex-basis: 100%; }
  }
</style>

<script>
  import { assemblePrompt } from '../data/kueche/schema.js';
  import rezepteJson from '../data/kueche/rezepte.json';
  import rollenJson from '../data/kueche/rollen.json';
  import formateJson from '../data/kueche/formate.json';
  import tabusJson from '../data/kueche/tabus.json';
  import { openInTool, copyToClipboard, TOOL_LABEL } from '../scripts/kanaele.js';

  const catalog = {
    rezepte: rezepteJson.rezepte,
    rollen: rollenJson.rollen,
    formate: formateJson,
    tabus: tabusJson.tabus,
  };

  // ===== Grundeinstellungen (Station 0, localStorage) =====
  const SETTINGS_KEY = 'pp_kueche_settings';
  const DEFAULT_SETTINGS = { schulform: '', fach: '', klassenstufe: '', zielTool: 'ais' };
  function loadSettings() {
    try { return { ...DEFAULT_SETTINGS, ...(JSON.parse(localStorage.getItem(SETTINGS_KEY) || '{}')) }; }
    catch (e) { return { ...DEFAULT_SETTINGS }; }
  }
  function saveSettings(s) { try { localStorage.setItem(SETTINGS_KEY, JSON.stringify(s)); } catch (e) { /* egal */ } }

  // ===== Zustand =====
  const state = {
    settings: loadSettings(),
    rezeptId: '', thema: '', material: '',
    gaeste: { vorwissen: '', sprachniveau: '', besonderheiten: [] },
    rolleId: '', rolleFreitext: '',
    format: '', laenge: '', ton: '',
    tabus: [], tabusFreitext: '',
  };

  const STATIONS = [
    { label: 'Was soll passieren?',        kueche: 'Rezept',    icon: '📋', pflicht: true,  render: renderRezept },
    { label: 'Worum geht’s?',              kueche: 'Zutaten',   icon: '🧺', pflicht: true,  render: renderZutaten },
    { label: 'Für wen?',                   kueche: 'Gäste',     icon: '👥', pflicht: false, render: renderGaeste },
    { label: 'Wer antwortet?',             kueche: 'Köchin',    icon: '👩‍🍳', pflicht: false, render: renderKoechin },
    { label: 'Wie soll es rauskommen?',    kueche: 'Anrichten', icon: '🍽️', pflicht: false, render: renderAnrichten },
    { label: 'Was gar nicht geht',         kueche: 'Allergien', icon: '🚫', pflicht: false, render: renderAllergien },
    { label: 'Fertig',                     kueche: 'Gericht',   icon: '✅', pflicht: false, render: renderErgebnis },
  ];
  let current = 0;

  // ===== Element-Refs =====
  const bodyEl = document.getElementById('k-body');
  const labelEl = document.getElementById('k-label');
  const iconEl = document.getElementById('k-icon');
  const kuecheEl = document.getElementById('k-kueche');
  const pflichtEl = document.getElementById('k-pflicht');
  const progressEl = document.getElementById('k-progress');
  const backBtn = document.getElementById('k-back');
  const nextBtn = document.getElementById('k-next');
  const setToggle = document.getElementById('k-settings-toggle');
  const setPanel = document.getElementById('k-settings');
  const setEls = {
    schulform: document.getElementById('set-schulform'),
    fach: document.getElementById('set-fach'),
    klassenstufe: document.getElementById('set-klassenstufe'),
    zielTool: document.getElementById('set-tool'),
  };

  // Settings-UI verdrahten
  Object.entries(setEls).forEach(([k, el]) => {
    el.value = state.settings[k];
    const upd = () => { state.settings[k] = el.value; saveSettings(state.settings); };
    el.addEventListener('input', upd);
    el.addEventListener('change', upd);
  });
  setToggle.addEventListener('click', () => {
    const willOpen = setPanel.hidden;
    setPanel.hidden = !willOpen;
    setToggle.setAttribute('aria-expanded', String(willOpen));
  });

  // ===== kleine DOM-Helfer =====
  function el(tag, cls, txt) { const e = document.createElement(tag); if (cls) e.className = cls; if (txt != null) e.textContent = txt; return e; }
  function toggleArr(arr, v) { const i = arr.indexOf(v); if (i >= 0) arr.splice(i, 1); else arr.push(v); }
  function chip(label, selected, onClick) {
    const b = el('button', 'wz-chip' + (selected ? ' selected' : ''), label);
    b.type = 'button';
    b.setAttribute('aria-pressed', selected ? 'true' : 'false');
    b.addEventListener('click', onClick);
    return b;
  }
  function singleChipField(label, items, getVal, setVal) {
    const fs = el('div', 'kueche-fieldset');
    fs.appendChild(el('span', 'kueche-fieldlabel', label));
    const wrap = el('div', 'wz-chips');
    items.forEach((it) => {
      const b = chip(it.label, getVal() === it.id, () => {
        setVal(it.id);
        wrap.querySelectorAll('.wz-chip').forEach((c) => { c.classList.remove('selected'); c.setAttribute('aria-pressed', 'false'); });
        b.classList.add('selected'); b.setAttribute('aria-pressed', 'true');
      });
      wrap.appendChild(b);
    });
    fs.appendChild(wrap);
    return fs;
  }
  function textField(label, placeholder, value, onInput, long) {
    const l = el('label', 'builder-field');
    l.appendChild(el('span', null, label));
    const input = el(long ? 'textarea' : 'input');
    if (long) input.rows = 6; else input.type = 'text';
    input.placeholder = placeholder || '';
    input.value = value || '';
    input.autocomplete = 'off';
    input.addEventListener('input', () => onInput(input.value));
    l.appendChild(input);
    l._input = input;
    return l;
  }

  // ===== Rezept-Auswahl wendet Defaults an =====
  function selectRezept(id) {
    state.rezeptId = id;
    const r = catalog.rezepte.find((x) => x.id === id);
    const d = (r && r.defaults) || {};
    const refined = (rollenJson.nachSchulform || {})[state.settings.schulform];
    state.rolleId = refined || d.rolleId || '';
    state.rolleFreitext = '';
    state.format = d.format || '';
    state.laenge = d.laenge || '';
    state.ton = d.ton || '';
    state.tabus = [...(d.tabus || [])];
  }

  // ===== Stationen =====
  function renderRezept() {
    const grid = el('div', 'k-rezept-grid');
    catalog.rezepte.forEach((r) => {
      const card = el('button', 'k-rezept-card' + (state.rezeptId === r.id ? ' selected' : ''));
      card.type = 'button';
      card.setAttribute('aria-pressed', state.rezeptId === r.id ? 'true' : 'false');
      card.appendChild(el('span', 'k-rezept-icon', r.icon)).setAttribute('aria-hidden', 'true');
      card.appendChild(el('span', 'k-rezept-label', r.label));
      card.appendChild(el('span', 'k-rezept-desc', r.beschreibung));
      card.addEventListener('click', () => { selectRezept(r.id); renderStation(); });
      grid.appendChild(card);
    });
    bodyEl.appendChild(grid);
  }

  function renderZutaten() {
    const t = textField('Thema oder Anlass', 'z. B. Photosynthese, Elternabend, Bruchrechnen', state.thema, (v) => { state.thema = v; updateNav(); }, false);
    const m = textField('Vorhandenes Material einfügen (optional)', 'Text, Aufgabenstellung oder Schüler:innentext hier einfügen …', state.material, (v) => { state.material = v; }, true);
    bodyEl.append(t, m);
    setTimeout(() => t._input.focus(), 40);
  }

  function renderGaeste() {
    const parts = [];
    if (state.settings.fach) parts.push('Fach ' + state.settings.fach);
    if (state.settings.schulform) parts.push(state.settings.schulform);
    if (state.settings.klassenstufe) parts.push('Klasse ' + state.settings.klassenstufe);
    const rem = el('p', 'kueche-hint');
    rem.append(document.createTextNode(parts.length ? 'Aus deinen Grundeinstellungen: ' + parts.join(', ') + '. ' : 'Noch keine Grundeinstellungen gesetzt. '));
    const open = el('button', 'k-linklike', parts.length ? 'ändern' : 'Grundeinstellungen öffnen');
    open.type = 'button';
    open.addEventListener('click', () => { setPanel.hidden = false; setToggle.setAttribute('aria-expanded', 'true'); setPanel.scrollIntoView({ behavior: 'smooth' }); });
    rem.appendChild(open);
    bodyEl.appendChild(rem);

    bodyEl.appendChild(textField('Vorwissen (optional)', 'Was ist schon bekannt?', state.gaeste.vorwissen, (v) => { state.gaeste.vorwissen = v; }, false));
    bodyEl.appendChild(textField('Sprachniveau (optional)', 'z. B. einfache Sprache, Fachsprache okay', state.gaeste.sprachniveau, (v) => { state.gaeste.sprachniveau = v; }, false));

    const fs = el('div', 'kueche-fieldset');
    fs.appendChild(el('span', 'kueche-fieldlabel', 'Besonderheiten (Mehrfachauswahl, optional)'));
    const wrap = el('div', 'wz-chips');
    ['DaZ / Deutsch als Zweitsprache', 'Nachteilsausgleich', 'heterogene Gruppe'].forEach((b) => {
      wrap.appendChild(chip(b, state.gaeste.besonderheiten.includes(b), (e) => {
        toggleArr(state.gaeste.besonderheiten, b);
        const on = state.gaeste.besonderheiten.includes(b);
        e.currentTarget.classList.toggle('selected', on);
        e.currentTarget.setAttribute('aria-pressed', on ? 'true' : 'false');
      }));
    });
    fs.appendChild(wrap);
    bodyEl.appendChild(fs);
  }

  function renderKoechin() {
    bodyEl.appendChild(el('p', 'kueche-hint', 'Vorschlag passend zu deiner Auswahl. Du kannst ihn ändern oder eine eigene Rolle schreiben.'));
    const l = el('label', 'builder-field');
    l.appendChild(el('span', null, 'Rolle der KI'));
    const sel = el('select');
    catalog.rollen.forEach((r) => {
      const o = el('option', null, r.label); o.value = r.id;
      if (!state.rolleFreitext && (state.rolleId || '') === r.id) o.selected = true;
      sel.appendChild(o);
    });
    const oFree = el('option', null, 'Eigene Rolle …'); oFree.value = '__frei';
    if (state.rolleFreitext) oFree.selected = true;
    sel.appendChild(oFree);
    l.appendChild(sel);

    const free = el('input', 'builder-field-free');
    free.type = 'text'; free.placeholder = 'Eigene Rolle beschreiben, z. B. „strenge:r Prüfer:in“';
    free.value = state.rolleFreitext || ''; free.hidden = !state.rolleFreitext;
    free.style.marginTop = '0.5rem';
    sel.addEventListener('change', () => {
      if (sel.value === '__frei') { free.hidden = false; state.rolleId = ''; setTimeout(() => free.focus(), 30); }
      else { free.hidden = true; state.rolleFreitext = ''; state.rolleId = sel.value; }
    });
    free.addEventListener('input', () => { state.rolleFreitext = free.value; });
    l.appendChild(free);
    bodyEl.appendChild(l);
  }

  function renderAnrichten() {
    bodyEl.appendChild(singleChipField('Format', catalog.formate.formate, () => state.format, (id) => { state.format = id; }));
    bodyEl.appendChild(singleChipField('Länge', catalog.formate.laengen, () => state.laenge, (id) => { state.laenge = id; }));
    bodyEl.appendChild(singleChipField('Ton', catalog.formate.toene, () => state.ton, (id) => { state.ton = id; }));
  }

  function renderAllergien() {
    const fs = el('div', 'kueche-fieldset');
    fs.appendChild(el('span', 'kueche-fieldlabel', 'Was die KI vermeiden soll (Mehrfachauswahl, optional)'));
    const wrap = el('div', 'wz-chips');
    catalog.tabus.forEach((t) => {
      wrap.appendChild(chip(t.label, state.tabus.includes(t.id), (e) => {
        toggleArr(state.tabus, t.id);
        const on = state.tabus.includes(t.id);
        e.currentTarget.classList.toggle('selected', on);
        e.currentTarget.setAttribute('aria-pressed', on ? 'true' : 'false');
      }));
    });
    fs.appendChild(wrap);
    bodyEl.appendChild(fs);
    bodyEl.appendChild(textField('Noch etwas, das nicht sein soll? (optional)', 'z. B. keine Fremdwörter', state.tabusFreitext, (v) => { state.tabusFreitext = v; }, false));
  }

  function renderErgebnis() {
    const prompt = assemblePrompt(state, catalog);
    const pre = el('pre', 'k-prompt', prompt);
    bodyEl.appendChild(pre);

    const tool = state.settings.zielTool || 'ais';
    const actions = el('div', 'k-actions');
    const openBtn = el('button', 'ais-btn'); openBtn.type = 'button';
    openBtn.textContent = 'Kopieren & in ' + (TOOL_LABEL[tool] || 'AIS.chat') + ' öffnen';
    const copyBtn = el('button', 'secondary-btn', 'Nur kopieren'); copyBtn.type = 'button';
    actions.append(openBtn, copyBtn);
    bodyEl.appendChild(actions);

    const hint = el('p', 'ais-hint'); hint.hidden = true; hint.setAttribute('aria-live', 'polite');
    bodyEl.appendChild(hint);

    openBtn.addEventListener('click', async () => {
      const res = await openInTool(tool, pre.textContent);
      hint.hidden = false;
      hint.className = 'ais-hint' + (res.ok ? '' : ' ais-hint-error');
      hint.textContent = res.ok
        ? '✓ Kopiert. ' + (TOOL_LABEL[tool] || 'Das Tool') + ' öffnet sich in einem neuen Tab. Dort den Prompt mit Strg+V einfügen (am Mac: Cmd+V).'
        : '⚠ Kopieren hat nicht geklappt. Markiere den Text oben und kopiere ihn mit Strg+C.';
    });
    copyBtn.addEventListener('click', async () => {
      const ok = await copyToClipboard(pre.textContent);
      copyBtn.textContent = ok ? '✓ Kopiert' : '⚠ Fehler';
      setTimeout(() => { copyBtn.textContent = 'Nur kopieren'; }, 1500);
    });

    // Station 8 – Nachwürzen
    const na = el('div', 'k-nachwuerzen');
    const h = el('h3', 'kueche-fieldlabel');
    h.append(document.createTextNode('Nachwürzen '));
    h.appendChild(el('span', 'kueche-sub2', 'Abschmecken'));
    na.appendChild(h);
    na.appendChild(el('p', 'kueche-hint', 'Passt die Antwort noch nicht? Tippe auf einen Zuruf (wird kopiert) und füge ihn im selben Chat ein.'));
    const chips = el('div', 'nachfass-chips');
    ['Mach es kürzer.', 'Formuliere es einfacher.', 'Gib mir eine zweite Variante.', 'Ändere den Ton.'].forEach((txt) => {
      const b = el('button', 'nachfass-chip', txt); b.type = 'button';
      b.addEventListener('click', async () => {
        const ok = await copyToClipboard(txt);
        const prev = b.textContent;
        b.classList.toggle('copied', ok);
        b.textContent = ok ? '✓ Kopiert' : '⚠ Fehler';
        clearTimeout(b._t);
        b._t = setTimeout(() => { b.classList.remove('copied'); b.textContent = prev; }, 1400);
      });
      chips.appendChild(b);
    });
    na.appendChild(chips);
    bodyEl.appendChild(na);
  }

  // ===== Rendern + Navigation =====
  function renderStation() {
    const st = STATIONS[current];
    labelEl.textContent = st.label;
    iconEl.textContent = st.icon;
    kuecheEl.textContent = st.kueche;
    pflichtEl.textContent = st.pflicht ? 'nötig' : 'optional';
    pflichtEl.className = 'kueche-badge ' + (st.pflicht ? 'is-pflicht' : 'is-optional');

    progressEl.innerHTML = '';
    STATIONS.forEach((_, i) => {
      progressEl.appendChild(el('span', 'wz-dot' + (i < current ? ' done' : '') + (i === current ? ' active' : '')));
    });

    bodyEl.innerHTML = '';
    st.render();
    updateNav();
    bodyEl.focus();
  }

  function updateNav() {
    backBtn.disabled = current === 0;
    const last = current === STATIONS.length - 1;
    nextBtn.hidden = last;
    let ok = true;
    if (current === 0) ok = !!state.rezeptId;
    if (current === 1) ok = !!state.thema.trim();
    nextBtn.disabled = !ok;
    nextBtn.textContent = current === STATIONS.length - 2 ? 'Fertig' : 'Weiter';
  }

  backBtn.addEventListener('click', () => { if (current > 0) { current--; renderStation(); } });
  nextBtn.addEventListener('click', () => { if (current < STATIONS.length - 1 && !nextBtn.disabled) { current++; renderStation(); } });

  renderStation();
</script>
