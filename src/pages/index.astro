---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { AUFGABEN, SHOW_EMOJIS, SHOW_DEMO_SLOT } from '../data/einstieg.js';
import { ICONS } from '../data/icons.js';

const allPrompts = await getCollection('prompts');
const prompts = allPrompts
  .filter((p) => !p.data.pending)
  .map((p) => p.data);

const byId = new Map(allPrompts.map((p) => [p.id, p.data]));
// Anzahl auszufüllender Felder – repliziert die Dedup-Logik des Assistenten:
// gleiche benannte Platzhalter zählen einmal, generische [Eingabe] je nach Kontext einzeln.
const GENERIC_PH = /^(eingabe|eingeben|einfügen|einfuegen|hier\b.*|bitte\b.*|wert|angabe|\.{2,}|…|x)$/i;
const fieldCount = (t) => {
  const pre = (t || '').split(/\*\*\s*(?:Example|Beispiel)\b/i)[0];
  const re = /\[([^\]]+)\]/g;
  const keys = new Set();
  let m, g = 0;
  while ((m = re.exec(pre))) {
    const inner = m[1].trim();
    if (GENERIC_PH.test(inner)) {
      const seg = ((pre.slice(0, m.index).split(/[\n.;!?]/).pop()) || '').replace(/\*\*/g, '').trim();
      keys.add(/:\s*$/.test(seg) ? 'c:' + seg.toLowerCase() : 'g:' + (g++));
    } else {
      keys.add('v:' + inner.toLowerCase());
    }
  }
  return keys.size;
};

// Aufgaben-Kacheln auflösen: Ziel-Prompt suchen, Aufwandshinweis aus echter
// Feldzahl ableiten (überschreibbar via effort). Fehlt der Prompt, degradiert
// die Kachel still: Link zur Übersicht, neutraler Aufwandshinweis.
const aufgaben = AUFGABEN.map((a) => {
  const p = byId.get(a.promptId);
  const n = p ? fieldCount(p.prompt) : 0;
  const effort = a.effort
    || (n > 0 ? `${n} kurze ${n === 1 ? 'Frage' : 'Fragen'}` : 'ein paar kurze Fragen');
  return {
    ...a,
    href: p ? `tool#p-${a.promptId}` : 'tool',
    category: p ? p.category : '',
    effort,
  };
});

const categoryMeta = [
  {
    name: 'Unterrichtsvorbereitung',
    description: 'Stundenpläne, Lernziele, Sequenzen und Material. Schneller vorbereitet.',
    emoji: '📋',
  },
  {
    name: 'Kreativer Unterricht',
    description: 'Methoden wie Gruppenpuzzle, Stationenlernen, Schreibwerkstatt und Galerie-Gang.',
    emoji: '🎨',
  },
  {
    name: 'Arbeitsorganisation',
    description: 'Korrekturen, Konferenzen, Mailvorlagen, Halbjahresplanung. Weniger Aufwand im Alltag.',
    emoji: '🗂️',
  },
  {
    name: 'Individuelle Förderung',
    description: 'Förderpläne, Nachteilsausgleich, DaZ, Inklusion und Lernstrategien.',
    emoji: '🌱',
  },
  {
    name: 'Feedback',
    description: 'Formatives Feedback, Peer-Feedback, Selbstbeurteilung, Zeugniskommentare und Feedback-Kultur.',
    emoji: '💬',
  },
  {
    name: 'Elternkommunikation',
    description: 'Elternbriefe, Gespräche, schwierige Nachrichten, Elternabende und mehrsprachige Kommunikation.',
    emoji: '👨‍👩‍👧',
  },
  {
    name: 'Kreative/Verrückte Prompts',
    description: 'Ungewöhnliche Ideen: Krimi-Plot, Rollenspiele, Reverse Engineering. Für Abwechslung im Unterricht.',
    emoji: '🚀',
  },
];

const counts = {};
for (const p of prompts) {
  counts[p.category] = (counts[p.category] || 0) + 1;
}

const categories = categoryMeta.map((c) => ({
  ...c,
  count: counts[c.name] || 0,
}));

const total = prompts.length;
---

<Layout title="Prompt-Profi · KI-Prompts für Lehrkräfte">
  <header class="hero">
    <p class="brand">Prompt-Profi<span class="brand-dot">.</span></p>
    <h1>KI-Hilfe für Lehrkräfte</h1>
    <p class="hero-intro">
      KI kann dich bei der Unterrichtsvorbereitung, im Unterricht selbst und bei deinen sonstigen Aufgaben als Lehrkraft unterstützen. Wir helfen dir, die richtigen Worte für die KI zu finden.
    </p>
  </header>

  <!-- Hauptfunktion: den eigenen Prompt von Grund auf bauen -->
  <a href="/bauen" class="build-hero">
    <span class="build-hero-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a4 4 0 0 1 5.29 5.29l-8.4 8.4-4.24 1.06 1.06-4.24 8.4-8.4z"/><path d="m12.5 8.5 3 3"/></svg>
    </span>
    <span class="build-hero-body">
      <span class="build-hero-title">Eigenen Prompt bauen</span>
      <span class="build-hero-desc">Setz dir Schritt für Schritt aus Bausteinen deinen eigenen Prompt zusammen – Aufgabe, Rolle, Ton und Format. Der geführte Weg, wenn keine Vorlage genau passt.</span>
    </span>
    <span class="build-hero-cta">Los geht's
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </span>
  </a>

  <!-- Einstieg über typische Themen und Aufgaben -->
  <section class="chooser" aria-labelledby="chooser-title">
    <h2 id="chooser-title">Oder starte über ein typisches Thema</h2>
    <p class="chooser-lead">Wähl eine typische Aufgabe – der Assistent stellt dir ein paar kurze Fragen und schreibt daraus deinen fertigen Prompt.</p>
    <ul class="chooser-grid">
      {aufgaben.map((a) => (
        <li>
          <a href={a.href} class="tile" data-cat={a.category}>
            {SHOW_EMOJIS && a.icon && ICONS[a.icon] && <span class="tile-emoji" aria-hidden="true" set:html={ICONS[a.icon]} />}
            <span class="tile-main">
              <span class="tile-label">{a.label}</span>
              <span class="tile-desc">{a.desc}</span>
            </span>
            <span class="tile-foot">
              <span class="tile-cta">Los geht's
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
              <span class="tile-effort">{a.effort}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>


  <details id="so-gehts" class="onboarding">
    <summary>
      <span class="onboarding-label">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
        So funktioniert's
      </span>
      <span class="onboarding-sub">In 3 Schritten zum fertigen Prompt</span>
    </summary>
    <ol class="onboarding-steps">
      <li>
        <span class="on-num">1</span>
        <div><strong>Aufgabe wählen</strong><p>Oben eine Kachel antippen – oder unten eine Kategorie durchstöbern.</p></div>
      </li>
      <li>
        <span class="on-num">2</span>
        <div><strong>Ein paar kurze Fragen beantworten</strong><p>Der Assistent fragt Schritt für Schritt, zum Beispiel nach Fach und Thema.</p></div>
      </li>
      <li>
        <span class="on-num">3</span>
        <div><strong>Prompt kopieren und in AIS.chat einfügen</strong><p>Ein Klick kopiert den fertigen Text und öffnet AIS.chat.</p></div>
      </li>
    </ol>
  </details>

  {SHOW_DEMO_SLOT && (
    <div class="demo-slot" aria-hidden="true">
      {/* Platz für eine spätere 20-Sekunden-Demo (stumme Endlosschleife). Hier ein <video muted loop> einsetzen. */}
      <span class="demo-slot-label">Kurze Demo — folgt</span>
    </div>
  )}

  <h2 id="kategorien" class="section-title">Alle Kategorien</h2>
  <p class="section-lead">Fertige Prompts nach Thema – ansehen, anpassen, kopieren.</p>
  <ul class="cat-grid">
    {categories.map((c, i) => (
      <li>
        <a href={`tool?kategorie=${encodeURIComponent(c.name)}`} class="cat-card">
          <div class="cat-card-top">
            <span class="cat-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="cat-count">{c.count}</span>
          </div>
          <h2>{c.name}</h2>
          <p class="cat-desc">{c.description}</p>
          <span class="cat-arrow">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </a>
      </li>
    ))}
  </ul>

  <div class="all-link-wrap">
    <a href="tool" class="all-link">Alle {total} Prompts ansehen</a>
  </div>

  <p class="suggest-line">
    Kennst du einen Prompt, der gut funktioniert?
    <button id="open-submit" class="suggest-link" type="button">Schlag ihn vor →</button>
  </p>

  <!-- Submit-Modal (identisch mit tool.astro) -->
  <div id="submit-modal" class="modal" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="s-title">
    <div class="modal-backdrop" data-submit-close></div>
    <article class="modal-content submit-form">
      <header>
        <h2 id="s-title">Prompt vorschlagen</h2>
        <button class="icon-btn" data-submit-close aria-label="Schließen" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </header>
      <p class="form-intro">
        Teile einen Prompt, der bei dir gut funktioniert. Nach einer kurzen Sichtung erscheint er hier, markiert als Community-Beitrag.
      </p>
      <div class="form-fields">
        <label>
          <span>Titel <span class="required">*</span></span>
          <input type="text" id="f-title" maxlength="120" required />
        </label>
        <label>
          <span>Kurzbeschreibung <span class="required">*</span></span>
          <textarea id="f-description" rows="2" maxlength="400" required placeholder="1-2 Sätze: Wann nutze ich diesen Prompt?"></textarea>
        </label>
        <div class="form-row">
          <label>
            <span>Kategorie <span class="required">*</span></span>
            <select id="f-category" required>
              <option value="">Bitte wählen</option>
              <option value="Unterrichtsvorbereitung">Unterrichtsvorbereitung</option>
              <option value="Kreativer Unterricht">Kreativer Unterricht</option>
              <option value="Arbeitsorganisation">Arbeitsorganisation</option>
              <option value="Individuelle Förderung">Individuelle Förderung</option>
              <option value="Feedback">Feedback</option>
              <option value="Elternkommunikation">Elternkommunikation</option>
              <option value="Kreative/Verrückte Prompts">Kreative/Verrückte Prompts</option>
            </select>
          </label>
          <label>
            <span>Schulstufe <span class="required">*</span></span>
            <select id="f-stage-sub" required>
              <option value="">Bitte wählen</option>
              <option value="Grundschule">Grundschule</option>
              <option value="Sek I">Sek I</option>
              <option value="Sek II">Sek II</option>
              <option value="Berufsschule">Berufsschule</option>
              <option value="Alle">Alle</option>
            </select>
          </label>
        </div>
        <label>
          <span>Fach <span class="required">*</span></span>
          <input type="text" id="f-subject-input" placeholder="z.B. Deutsch, Mathematik, Fächerübergreifend" required />
        </label>
        <label>
          <span>Prompt-Text <span class="required">*</span></span>
          <textarea id="f-prompt" rows="10" maxlength="8000" required placeholder="Der vollständige Prompt. Platzhalter in [eckigen Klammern]."></textarea>
        </label>
        <label class="honeypot" aria-hidden="true">
          Website (bitte leer lassen)
          <input type="text" id="f-website" tabindex="-1" autocomplete="off" />
        </label>
      </div>
      <div class="form-actions">
        <button class="btn-secondary" type="button" data-submit-close>Abbrechen</button>
        <button class="btn-primary" type="button" id="submit-btn">Einreichen</button>
      </div>
      <p class="form-status" id="form-status" hidden></p>
    </article>
  </div>
</Layout>

<script>
  // ===== Onboarding "So funktioniert's" =====
  const onboarding = document.getElementById('so-gehts');
  if (onboarding) {
    // Erstbesuch: automatisch aufklappen, danach gemerkt einklappen lassen
    try {
      if (!localStorage.getItem('pp_seen_onboarding')) {
        onboarding.open = true;
        localStorage.setItem('pp_seen_onboarding', '1');
      }
    } catch (e) { /* localStorage blockiert -> bleibt eingeklappt, kein Fehler */ }
    // Aufruf über #so-gehts (Footer-Link): aufklappen + hinscrollen
    const openFromHash = () => {
      if (location.hash === '#so-gehts') {
        onboarding.open = true;
        onboarding.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    };
    openFromHash();
    window.addEventListener('hashchange', openFromHash);
  }

  const FORM_ENDPOINT = 'https://prompt-profi-forms.gbabing.workers.dev';

  const openSubmit = document.getElementById('open-submit');
  const submitModal = document.getElementById('submit-modal');
  const submitBtn = document.getElementById('submit-btn');
  const formStatus = document.getElementById('form-status');
  const fTitle = document.getElementById('f-title');
  const fDesc = document.getElementById('f-description');
  const fCategory = document.getElementById('f-category');
  const fStageSub = document.getElementById('f-stage-sub');
  const fSubjectInput = document.getElementById('f-subject-input');
  const fPrompt = document.getElementById('f-prompt');
  const fWebsite = document.getElementById('f-website');

  function openSubmitModal() {
    submitModal.hidden = false;
    submitModal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    formStatus.hidden = true;
    setTimeout(() => fTitle.focus(), 100);
  }

  function closeSubmitModal() {
    submitModal.hidden = true;
    submitModal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  openSubmit.addEventListener('click', openSubmitModal);
  submitModal.addEventListener('click', (e) => {
    if (e.target.closest('[data-submit-close]')) closeSubmitModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !submitModal.hidden) closeSubmitModal();
  });

  function showStatus(text, type) {
    formStatus.textContent = text;
    formStatus.className = 'form-status status-' + type;
    formStatus.hidden = false;
  }

  submitBtn.addEventListener('click', async () => {
    const fields = [
      { el: fTitle, name: 'Titel' },
      { el: fDesc, name: 'Kurzbeschreibung' },
      { el: fCategory, name: 'Kategorie' },
      { el: fStageSub, name: 'Schulstufe' },
      { el: fSubjectInput, name: 'Fach' },
      { el: fPrompt, name: 'Prompt-Text' },
    ];
    for (const f of fields) {
      if (!f.el.value || f.el.value.trim().length === 0) {
        showStatus(`Bitte fülle das Feld "${f.name}" aus.`, 'error');
        f.el.focus();
        return;
      }
    }
    submitBtn.disabled = true;
    submitBtn.textContent = 'Wird übermittelt …';
    showStatus('Einreichung wird übermittelt …', 'info');
    try {
      const res = await fetch(FORM_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title: fTitle.value.trim(),
          description: fDesc.value.trim(),
          category: fCategory.value,
          stage: fStageSub.value,
          subject: fSubjectInput.value.trim(),
          prompt: fPrompt.value.trim(),
          website: fWebsite.value,
        }),
      });
      const result = await res.json();
      if (res.ok) {
        showStatus('Vielen Dank! Dein Prompt wurde eingereicht und wird gesichtet.', 'success');
        fTitle.value = ''; fDesc.value = ''; fCategory.value = '';
        fStageSub.value = ''; fSubjectInput.value = ''; fPrompt.value = '';
        setTimeout(closeSubmitModal, 2500);
      } else {
        showStatus('Fehler: ' + (result.error || 'Unbekannt'), 'error');
      }
    } catch (e) {
      showStatus('Netzwerkfehler. Bitte später erneut versuchen.', 'error');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Einreichen';
    }
  });
</script>

