---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allPrompts = await getCollection('prompts');
const prompts = allPrompts
  .map((p) => ({ id: p.id, ...p.data }))
  .sort((a, b) => (a.order ?? 999) - (b.order ?? 999));

const categories = [...new Set(prompts.map((p) => p.category))].sort();
const stages = [...new Set(prompts.map((p) => p.stage))].sort();
const subjects = [...new Set(prompts.map((p) => p.subject))].sort();
---

<Layout title="Prompt-Profi · KI-Prompts für Lehrkräfte">
  <header class="hero">
    <a href="/" class="back-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;vertical-align:-2px;margin-right:4px;"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Alle Kategorien
    </a>
    <h1>Prompt-Profi</h1>
    <p>Geprüfte KI-Prompts für den Schulalltag.</p>
    <button id="open-submit" class="submit-cta" type="button">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
      Eigenen Prompt vorschlagen
    </button>
  </header>

  <div class="controls">
    <div class="search-wrap">
      <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>
      </svg>
      <input type="text" id="search" placeholder="Suchen nach Titel, Inhalt oder Stichwort …" autocomplete="off" />
    </div>

    <div class="filters">
      <select id="f-cat" aria-label="Kategorie">
        <option value="">Alle Kategorien</option>
        {categories.map((c) => <option value={c}>{c}</option>)}
      </select>
      <select id="f-stage" aria-label="Schulstufe">
        <option value="">Alle Schulstufen</option>
        {stages.map((s) => <option value={s}>{s}</option>)}
      </select>
      <select id="f-subject" aria-label="Fach">
        <option value="">Alle Fächer</option>
        {subjects.map((s) => <option value={s}>{s}</option>)}
      </select>
      <button id="f-fav" type="button" class="fav-filter" aria-pressed="false" title="Nur meine Favoriten">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 1 0-7.8 7.8l1.1 1L12 21l7.7-7.6 1.1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
        Favoriten
      </button>
      <button id="reset" type="button" aria-label="Filter zurücksetzen" title="Filter zurücksetzen">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 12a9 9 0 1 0 9-9"/><path d="M3 4v5h5"/>
        </svg>
      </button>
    </div>

    <div class="controls-foot">
      <p class="count"><span id="count">{prompts.length}</span> Prompts</p>
      <button id="ctx-reset" class="ctx-reset" type="button" hidden>Gemerkte Angaben (Fach, Klasse) löschen</button>
    </div>
  </div>

  <ul id="grid" class="grid">
    {prompts.map((p) => (
      <li
        class="card"
        data-id={p.id}
        data-cat={p.category}
        data-stage={p.stage}
        data-subject={p.subject}
        data-haystack={`${p.title} ${p.description} ${p.prompt} ${p.category} ${p.subject}`.toLowerCase()}
      >
        <button class="fav-btn" type="button" data-fav-id={p.id} aria-label="Zu Favoriten hinzufügen" aria-pressed="false" title="Zu Favoriten">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 1 0-7.8 7.8l1.1 1L12 21l7.7-7.6 1.1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
        </button>
        <h2>{p.title}</h2>
        <p class="desc">{p.description}</p>
        <div class="card-footer">
          <div class="badges">
            <span class="badge badge-cat">{p.category}</span>
            <span class="badge badge-stage">{p.stage}</span>
            <span class="badge badge-subject">{p.subject}</span>
            {p.community && <span class="badge badge-community">Community</span>}
          </div>
          <button class="card-copy" type="button" data-copy-id={p.id} aria-label="Prompt kopieren" title="Prompt kopieren">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            Kopieren
          </button>
        </div>
      </li>
    ))}
  </ul>

  <div id="empty" class="empty" hidden>
    Keine Prompts gefunden. <button id="empty-reset" type="button">Filter zurücksetzen</button>
  </div>

  <!-- Prompt-Daten als JSON für Modal -->
  <script type="application/json" id="prompts-data" set:html={JSON.stringify(
    prompts.reduce((acc, p) => {
      acc[p.id] = { title: p.title, description: p.description, prompt: p.prompt, hint: p.hint, category: p.category, stage: p.stage, subject: p.subject, community: p.community, personenbezug: p.personenbezug, nachfassPrompts: p.nachfassPrompts };
      return acc;
    }, {})
  )} />
  <!-- Submit-Modal -->
  <div id="submit-modal" class="modal" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="s-title">
    <div class="modal-backdrop" data-submit-close></div>
    <article class="modal-content submit-form">
      <header>
        <h2 id="s-title">Prompt vorschlagen</h2>
        <button class="icon-btn" data-submit-close aria-label="Schließen" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </header>
      <p class="form-intro">
        Teile einen Prompt, der bei dir gut funktioniert. Nach einer kurzen Prüfung erscheint er hier, markiert als Community-Beitrag.
      </p>
      <div class="form-fields">
        <label>
          <span>Titel <span class="required">*</span></span>
          <input type="text" id="f-title" maxlength="120" required />
        </label>
        <label>
          <span>Kurzbeschreibung <span class="required">*</span></span>
          <textarea id="f-description" rows="2" maxlength="400" required placeholder="1-2 Sätze: Wann nutze ich diesen Prompt?"></textarea>
        </label>
        <div class="form-row">
          <label>
            <span>Kategorie <span class="required">*</span></span>
            <select id="f-category" required>
              <option value="">Bitte wählen</option>
              <option value="Unterrichtsvorbereitung">Unterrichtsvorbereitung</option>
              <option value="Kreativer Unterricht">Kreativer Unterricht</option>
              <option value="Arbeitsorganisation">Arbeitsorganisation</option>
              <option value="Differenzierung">Differenzierung</option>
              <option value="Feedback">Feedback</option>
              <option value="Elternkommunikation">Elternkommunikation</option>
            </select>
          </label>
          <label>
            <span>Schulstufe <span class="required">*</span></span>
            <select id="f-stage-sub" required>
              <option value="">Bitte wählen</option>
              <option value="Grundschule">Grundschule</option>
              <option value="Sek I">Sek I</option>
              <option value="Sek II">Sek II</option>
              <option value="Berufsschule">Berufsschule</option>
              <option value="Alle">Alle</option>
            </select>
          </label>
        </div>
        <label>
          <span>Fach <span class="required">*</span></span>
          <input type="text" id="f-subject-input" placeholder="z. B. Deutsch, Mathematik, Fächerübergreifend" required />
        </label>
        <label>
          <span>Prompt-Text <span class="required">*</span></span>
          <textarea id="f-prompt" rows="10" maxlength="8000" required placeholder="Der vollständige Prompt. Platzhalter in [eckigen Klammern]."></textarea>
        </label>
        <!-- Honeypot - versteckt, fängt Bots -->
        <label class="honeypot" aria-hidden="true">
          Website (bitte leer lassen)
          <input type="text" id="f-website" tabindex="-1" autocomplete="off" />
        </label>
      </div>
      <div class="form-actions">
        <button class="btn-secondary" type="button" data-submit-close>Abbrechen</button>
        <button class="btn-primary" type="button" id="submit-btn">Einreichen</button>
      </div>
      <p class="form-status" id="form-status" hidden></p>
    </article>
  </div>
  <!-- Modal -->
  <div id="modal" class="modal" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="m-title">
    <div class="modal-backdrop" data-close></div>
    <article class="modal-content">
      <header>
        <h2 id="m-title"></h2>
        <button class="icon-btn" data-close aria-label="Schließen">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </header>
      <div class="modal-badges" id="m-badges"></div>
      <p class="modal-desc" id="m-desc"></p>
      <!-- Datenschutz-Ampel (nur bei personenbezug) -->
      <div class="privacy-note" id="m-privacy" hidden>
        <svg class="privacy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <div class="privacy-text">
          <strong>Keine echten Schülerdaten nötig.</strong>
          Auch in AIS.chat brauchst du keine echten Namen oder Noten. Schreib stattdessen zum Beispiel „Schüler:in A".
          <a href="/ki-datenschutz" class="privacy-link">Mehr zu KI &amp; Datenschutz</a>
        </div>
      </div>
      <!-- Schritt-für-Schritt-Assistent -->
      <div class="wizard" id="m-wizard" hidden>
        <div class="wizard-step" id="wz-step">
          <div class="wizard-progress">
            <span class="wizard-count" id="wz-count"></span>
            <div class="wizard-dots" id="wz-dots"></div>
          </div>
          <h3 class="wizard-q" id="wz-q"></h3>
          <p class="wizard-help" id="wz-help"></p>
          <div class="wizard-input" id="wz-input"></div>
          <div class="wizard-context" id="wz-context" hidden>
            <span class="wizard-context-label">So sieht es im Prompt aus</span>
            <p class="wizard-context-text" id="wz-context-text"></p>
          </div>
          <div class="wizard-nav">
            <button type="button" class="wz-skip" id="wz-skip">Überspringen</button>
            <div class="wizard-nav-main">
              <button type="button" class="wz-back" id="wz-back">Zurück</button>
              <button type="button" class="wz-next" id="wz-next">Weiter</button>
            </div>
          </div>
        </div>
        <div class="wizard-done" id="wz-done" hidden>
          <div class="wizard-done-head">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="wizard-done-title">Fertig!</span>
          </div>
          <p>Schau dir den Prompt unten an und kopiere ihn.</p>
          <button type="button" class="wz-done-reset" id="wz-done-reset">← Antworten ändern</button>
        </div>
        <button type="button" class="wizard-toggle" id="wz-toggle-all">Alle Felder auf einmal ausfüllen</button>
      </div>

      <!-- Alle Felder auf einmal (für Profis) -->
      <div class="builder" id="m-builder" hidden>
        <div class="builder-head">
          <span class="builder-title">Alle Platzhalter</span>
          <button class="builder-reset" id="m-builder-reset" type="button">Zurücksetzen</button>
        </div>
        <p class="builder-hint">Fülle die Felder aus. Der Prompt unten füllt sich dabei von selbst. Was du frei lässt, bleibt als [Platzhalter] stehen.</p>
        <div class="builder-fields" id="m-builder-fields"></div>
        <button type="button" class="wizard-toggle" id="wz-toggle-wizard">← Wieder Schritt für Schritt ausfüllen</button>
      </div>

      <div class="prompt-wrap" id="m-result">
        <pre id="m-prompt"></pre>
        <button class="copy-btn" id="m-copy" title="Nur den Prompt kopieren">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          Kopieren
        </button>
      </div>

      <div id="m-after" hidden>
      <!-- Primäraktion: AIS.chat -->
      <div class="tool-actions">
        <button class="ais-btn" id="m-ais" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          Kopieren &amp; in AIS.chat öffnen
        </button>
      </div>
      <p class="ais-hint" id="m-ais-hint" hidden aria-live="polite"></p>

      <!-- Sekundär: andere KI-Tools -->
      <details class="other-tools" id="m-other-tools">
        <summary>Andere KI-Tools (ChatGPT, Claude, Copilot)</summary>
        <div class="other-tools-body">
          <p class="other-warn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><path d="M12 9v4M12 17h.01"/></svg>
            <span><strong>Achtung:</strong> Diese Tools sind nicht für Schülerdaten freigegeben. Gib hier keine echten Namen oder Noten ein. <a href="/ki-datenschutz" class="privacy-link">Mehr erfahren</a></span>
          </p>
          <div class="dl-row" id="m-deeplinks">
            <a class="dl-btn" id="m-dl-chatgpt" target="_blank" rel="noopener noreferrer">ChatGPT öffnen</a>
            <a class="dl-btn" id="m-dl-claude" target="_blank" rel="noopener noreferrer">Claude öffnen</a>
            <button class="dl-btn" id="m-dl-copilot" type="button">Copilot: kopieren &amp; öffnen</button>
          </div>
          <p class="dl-toolong" id="m-dl-toolong" hidden>Dieser Prompt ist zu lang zum direkten Öffnen. Kopiere ihn oben und füge ihn im Tool ein.</p>
        </div>
      </details>

      <!-- Nachfass-Prompts -->
      <div class="nachfass" id="m-nachfass" hidden>
        <p class="nachfass-intro">Passt die erste Antwort noch nicht? Tippe auf einen Vorschlag (wird kopiert) und füge ihn im selben Chat ein.</p>
        <div class="nachfass-chips" id="m-nachfass-chips"></div>
      </div>

      <p class="hint" id="m-hint" hidden></p>

      <div class="modal-actions">
        <button class="share-btn" id="m-share" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          Link kopieren
        </button>
      </div>
      </div><!-- /m-after -->
    </article>
  </div>
</Layout>

<script>
  import Fuse from 'fuse.js';

  const data = JSON.parse(document.getElementById('prompts-data').textContent);
  const grid = document.getElementById('grid');
  const cards = Array.from(grid.querySelectorAll('.card'));
  const search = document.getElementById('search');
  const fCat = document.getElementById('f-cat');
  const fStage = document.getElementById('f-stage');
  const fSubject = document.getElementById('f-subject');
  const reset = document.getElementById('reset');
  const emptyReset = document.getElementById('empty-reset');
  const count = document.getElementById('count');
  const empty = document.getElementById('empty');
  const favFilter = document.getElementById('f-fav');
  const ctxReset = document.getElementById('ctx-reset');

  // ===== localStorage (still degradierend, wenn nicht verfügbar) =====
  const store = {
    get(k) { try { return localStorage.getItem(k); } catch (e) { return null; } },
    set(k, v) { try { localStorage.setItem(k, v); return true; } catch (e) { return false; } },
    remove(k) { try { localStorage.removeItem(k); } catch (e) { /* egal */ } },
  };
  const FAV_KEY = 'pp_favs';
  const CTX_KEY = 'pp_context';

  // Favoriten (Set von IDs) — in-memory, bei Verfügbarkeit persistiert
  let favs = new Set();
  try {
    const raw = store.get(FAV_KEY);
    if (raw) favs = new Set(JSON.parse(raw));
  } catch (e) { favs = new Set(); }
  function saveFavs() { store.set(FAV_KEY, JSON.stringify([...favs])); }
  let favOnly = false;

  // Kontext-Standards (Fach / Klassenstufe)
  let ctxDefaults = {};
  try {
    const raw = store.get(CTX_KEY);
    if (raw) ctxDefaults = JSON.parse(raw) || {};
  } catch (e) { ctxDefaults = {}; }
  function saveCtx() { store.set(CTX_KEY, JSON.stringify(ctxDefaults)); }
  function hasCtxDefaults() { return !!(ctxDefaults.fach || ctxDefaults.stufe); }
  // Erkennt, ob ein Feld ein Standard-Kontextfeld ist (fach / stufe) — für Vorbelegung
  function contextKindOf(field) {
    const l = (field.label || '').toLowerCase();
    if (/^fach\b/.test(l) || l === 'fach' || /unterrichtsfach/.test(l)) return 'fach';
    if (/klassenstufe|jahrgangsstufe|jahrgang|schulform|klasse|schulstufe|\bstufe\b/.test(l)) return 'stufe';
    return null;
  }

  // Fuse.js: gewichtete, tippfehler-tolerante Suche über alle Prompts
  const items = Object.entries(data).map(([id, p]) => ({ id, ...p }));
  const fuse = new Fuse(items, {
    includeScore: true,
    includeMatches: true,
    ignoreLocation: true,
    threshold: 0.4,
    minMatchCharLength: 2,
    keys: [
      { name: 'title', weight: 0.5 },
      { name: 'description', weight: 0.25 },
      { name: 'prompt', weight: 0.15 },
      { name: 'category', weight: 0.05 },
      { name: 'subject', weight: 0.05 },
    ],
  });

  const cardById = new Map(cards.map((c) => [c.dataset.id, c]));
  const originalOrder = cards.slice();

  function escapeHtml(s) {
    return s.replace(/[&<>"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[ch]));
  }

  function highlight(text, indices) {
    let html = '', last = 0;
    for (const [start, end] of indices) {
      if (start < last) continue; // überlappende Treffer überspringen
      html += escapeHtml(text.slice(last, start));
      html += '<mark>' + escapeHtml(text.slice(start, end + 1)) + '</mark>';
      last = end + 1;
    }
    return html + escapeHtml(text.slice(last));
  }

  function clearHighlights(card) {
    card.querySelector('h2').textContent = data[card.dataset.id].title;
    card.querySelector('.desc').textContent = data[card.dataset.id].description;
  }

  function applyHighlights(card, matches) {
    clearHighlights(card);
    for (const m of matches) {
      if (m.key === 'title') card.querySelector('h2').innerHTML = highlight(m.value, m.indices);
      else if (m.key === 'description') card.querySelector('.desc').innerHTML = highlight(m.value, m.indices);
    }
  }

  function passesFilter(card) {
    const c = fCat.value, s = fStage.value, sb = fSubject.value;
    return (!c || card.dataset.cat === c)
      && (!s || card.dataset.stage === s)
      && (!sb || card.dataset.subject === sb)
      && (!favOnly || favs.has(card.dataset.id));
  }

  function applyFilters() {
    const q = search.value.trim();
    let visible = 0;

    if (q) {
      const shown = new Set();
      const ordered = [];
      for (const r of fuse.search(q)) {
        const card = cardById.get(r.item.id);
        if (!card || !passesFilter(card)) continue;
        applyHighlights(card, r.matches || []);
        card.hidden = false;
        shown.add(card.dataset.id);
        ordered.push(card);
        visible++;
      }
      cards.forEach((card) => {
        if (!shown.has(card.dataset.id)) { card.hidden = true; clearHighlights(card); }
      });
      ordered.forEach((card) => grid.appendChild(card)); // nach Relevanz sortieren
    } else {
      originalOrder.forEach((card) => {
        clearHighlights(card);
        const show = passesFilter(card);
        card.hidden = !show;
        if (show) visible++;
        grid.appendChild(card); // Originalreihenfolge wiederherstellen
      });
    }

    count.textContent = visible;
    empty.hidden = visible !== 0;
    grid.hidden = visible === 0;
  }

  function resetFilters() {
    search.value = ''; fCat.value = ''; fStage.value = ''; fSubject.value = '';
    favOnly = false;
    favFilter.setAttribute('aria-pressed', 'false');
    favFilter.classList.remove('active');
    applyFilters();
  }

  // ===== Favoriten =====
  function reflectFavButton(btn, on) {
    btn.classList.toggle('is-fav', on);
    btn.setAttribute('aria-pressed', on ? 'true' : 'false');
    btn.setAttribute('aria-label', on ? 'Aus Favoriten entfernen' : 'Zu Favoriten hinzufügen');
  }
  grid.querySelectorAll('.fav-btn').forEach((btn) => {
    reflectFavButton(btn, favs.has(btn.dataset.favId));
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const id = btn.dataset.favId;
      if (favs.has(id)) favs.delete(id); else favs.add(id);
      saveFavs();
      reflectFavButton(btn, favs.has(id));
      if (favOnly) applyFilters(); // gefilterte Ansicht sofort aktualisieren
    });
    btn.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') e.stopPropagation(); });
  });

  favFilter.addEventListener('click', () => {
    favOnly = !favOnly;
    favFilter.setAttribute('aria-pressed', favOnly ? 'true' : 'false');
    favFilter.classList.toggle('active', favOnly);
    applyFilters();
  });

  // ===== Kontext-Standards zurücksetzen =====
  function reflectCtxReset() { ctxReset.hidden = !hasCtxDefaults(); }
  reflectCtxReset();
  ctxReset.addEventListener('click', () => {
    ctxDefaults = {};
    store.remove(CTX_KEY);
    reflectCtxReset();
    ctxReset.textContent = '✓ Angaben gelöscht';
    setTimeout(() => { ctxReset.textContent = 'Gemerkte Angaben (Fach, Klasse) löschen'; }, 1800);
  });

  // Kategorie aus URL-Parameter vorbelegen
  const params = new URLSearchParams(window.location.search);
  const kategorieParam = params.get('kategorie');
  if (kategorieParam) {
    const optionExists = Array.from(fCat.options).some((o) => o.value === kategorieParam);
    if (optionExists) fCat.value = kategorieParam;
  }
  applyFilters();

  search.addEventListener('input', applyFilters);
  [fCat, fStage, fSubject].forEach((el) => el.addEventListener('change', applyFilters));
  reset.addEventListener('click', resetFilters);
  emptyReset.addEventListener('click', resetFilters);

  // Modal
  const modal = document.getElementById('modal');
  const mTitle = document.getElementById('m-title');
  const mDesc = document.getElementById('m-desc');
  const mPrompt = document.getElementById('m-prompt');
  const mBadges = document.getElementById('m-badges');
  const mHint = document.getElementById('m-hint');
  const mCopy = document.getElementById('m-copy');
  const mShare = document.getElementById('m-share');
  const builder = document.getElementById('m-builder');
  const builderFields = document.getElementById('m-builder-fields');
  const builderReset = document.getElementById('m-builder-reset');

  // Assistent-Elemente
  const wizard = document.getElementById('m-wizard');
  const wzStep = document.getElementById('wz-step');
  const wzDone = document.getElementById('wz-done');
  const wzCount = document.getElementById('wz-count');
  const wzDots = document.getElementById('wz-dots');
  const wzQ = document.getElementById('wz-q');
  const wzHelp = document.getElementById('wz-help');
  const wzInput = document.getElementById('wz-input');
  const wzContext = document.getElementById('wz-context');
  const wzContextText = document.getElementById('wz-context-text');
  const wzSkip = document.getElementById('wz-skip');
  const wzBack = document.getElementById('wz-back');
  const wzNext = document.getElementById('wz-next');
  const wzToggleAll = document.getElementById('wz-toggle-all');
  const wzToggleWizard = document.getElementById('wz-toggle-wizard');
  const wzDoneReset = document.getElementById('wz-done-reset');
  const result = document.getElementById('m-result');
  const afterBlock = document.getElementById('m-after');
  // Prompt-Box + nachgelagerte Aktionen (AIS/andere Tools/Nachfass) gemeinsam ein-/ausblenden
  function showResult(v) { result.hidden = !v; afterBlock.hidden = !v; }

  // Zielkanäle / Tool-Aktionen
  const mPrivacy = document.getElementById('m-privacy');
  const mAis = document.getElementById('m-ais');
  const mAisHint = document.getElementById('m-ais-hint');
  const otherTools = document.getElementById('m-other-tools');
  const dlChatgpt = document.getElementById('m-dl-chatgpt');
  const dlClaude = document.getElementById('m-dl-claude');
  const dlCopilot = document.getElementById('m-dl-copilot');
  const dlToolong = document.getElementById('m-dl-toolong');
  const mNachfass = document.getElementById('m-nachfass');
  const mNachfassChips = document.getElementById('m-nachfass-chips');

  const AIS_URL = 'https://app.ais-chat.schule';       // verifizierte AIS.chat-App (VIDIS/Code-Login)
  const COPILOT_URL = 'https://copilot.microsoft.com'; // Copilot: kein zuverlässiger Prefill -> kopieren & öffnen
  const URL_MAX = 2000;                                 // ab hier kein Prefill-Deeplink, nur Kopieren
  const AIS_HINT_TEXT = '✓ Kopiert. AIS.chat öffnet sich in einem neuen Tab. Dort einloggen und den Prompt mit Strg+V einfügen (am Mac: Cmd+V).';
  const DEFAULT_NACHFASS = [
    'Mach es kürzer.',
    'Formuliere einfacher für [Klassenstufe].',
    'Erstelle mir ein passendes Arbeitsblatt dazu.',
    'Gib mir eine leichtere und eine schwerere Variante (Differenzierung).',
  ];

  // Text in die Zwischenablage kopieren (mit Fallback für ältere/eingeschränkte Umgebungen)
  async function copyToClipboard(text) {
    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(text);
        return true;
      }
    } catch (e) { /* Fallback unten */ }
    try {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.focus(); ta.select();
      const ok = document.execCommand('copy');
      document.body.removeChild(ta);
      return ok;
    } catch (e) { return false; }
  }

  // ===== Platzhalter-Baukasten =====
  let currentTemplate = '';
  let occurrences = [];            // Platzhalter in Textreihenfolge -> { key }
  let wizardFields = [];           // eindeutige Felder = Schritte
  let wizardIndex = 0;             // aktueller Schritt
  const fieldValues = new Map();   // key -> eingegebener Wert

  // Generische Füllwörter, die als Label nichts erklären
  const GENERIC = /^(eingabe|eingeben|einfügen|einfuegen|hier\b.*|bitte\b.*|wert|angabe|\.{2,}|…|x)$/i;
  // Platzhalter, die längeren Fließtext erwarten -> großes Textfeld
  const LONG = /(einfüg|einfug|\btext\b|mail|brief|beschreib|situation|absatz|auszug|inhalt|aufsatz|passage|zitat|verlauf|vorgeschichte|sichtweise|problem|nachricht|kontext|szenario|beitrag)/i;

  // Das Wort/die Wörter direkt vor dem Platzhalter ("Zeit für Bearbeitung: [...]")
  function contextLabel(before) {
    let seg = (before.split(/[\n.;!?]/).pop() || '').replace(/\*\*/g, '').trim();
    if (!/:\s*$/.test(seg)) return '';                 // nur "Label: [...]"-Muster
    let label = seg.replace(/:\s*$/, '').trim();       // abschließenden Doppelpunkt entfernen
    // Verschachtelte "Oberlabel: Unterlabel" -> nur das Unterlabel ("Context: Fach" -> "Fach")
    if (label.includes(':')) label = label.slice(label.lastIndexOf(':') + 1).trim();
    label = label.replace(/^[\d.)\-•\s]+/, '').trim(); // führende Aufzählungszeichen
    const words = label.split(/\s+/);
    if (words.length > 6) label = words.slice(-6).join(' ');
    return label;
  }

  function capitalize(s) { return s ? s.charAt(0).toUpperCase() + s.slice(1) : s; }

  function analyze(template) {
    occurrences = [];
    const map = new Map();
    const re = /\[([^\]]+)\]/g;
    let m, genCount = 0;
    while ((m = re.exec(template))) {
      const inner = m[1].trim();
      const ctx = contextLabel(template.slice(0, m.index));
      const generic = GENERIC.test(inner);
      const key = !generic ? 'v:' + inner.toLowerCase()
        : ctx ? 'c:' + ctx.toLowerCase()
        : 'g:' + (genCount++);
      occurrences.push({ key });
      if (map.has(key)) continue;

      const options = inner.includes(' / ')
        ? inner.split('/').map((o) => o.trim()).filter((o) => o && o !== '...' && o !== '…' && o.length <= 30)
        : [];
      const label = capitalize(generic ? (ctx || 'Deine Eingabe') : (ctx || inner));
      // Hilfszeile nur, wenn sie echten Zusatznutzen bietet
      let hint = '';
      if (options.length < 2 && !generic && ctx && ctx.toLowerCase() !== inner.toLowerCase()) {
        hint = inner.replace(/^(eingabe|eingeben|angabe)\s*[—:-]\s*/i, '').trim();
      }
      const long = options.length < 2 && (LONG.test(inner) || LONG.test(ctx) || inner.length > 32);
      map.set(key, { key, label, hint, long, options });
    }
    return [...map.values()];
  }

  function renderPreview() {
    let i = 0;
    mPrompt.textContent = currentTemplate.replace(/\[[^\]]+\]/g, (match) => {
      const occ = occurrences[i++];
      const val = occ ? (fieldValues.get(occ.key) || '').trim() : '';
      return val || match;
    });
    updateToolLinks();
  }

  // Prefill-Deeplinks (ChatGPT/Claude) live mit dem aktuellen Prompt aktualisieren.
  // Zu lange Prompts: keinen Deeplink zeigen (nichts still abschneiden), Hinweis stattdessen.
  function updateToolLinks() {
    const text = mPrompt.textContent;
    const enc = encodeURIComponent(text);
    const tooLong = enc.length > URL_MAX;
    dlChatgpt.href = 'https://chatgpt.com/?q=' + enc;
    dlClaude.href = 'https://claude.ai/new?q=' + enc;
    dlChatgpt.hidden = tooLong;
    dlClaude.hidden = tooLong;
    dlToolong.hidden = !tooLong;
    // Copilot bleibt immer verfügbar (Kopieren & Öffnen, kein URL-Prefill).
  }

  // Zerlegt das Template in Text- und Platzhalter-Stücke (in Reihenfolge)
  function tokenize(tpl) {
    const parts = []; const re = /\[[^\]]+\]/g; let last = 0, m, pi = 0;
    while ((m = re.exec(tpl))) {
      if (m.index > last) parts.push({ t: 'text', v: tpl.slice(last, m.index) });
      parts.push({ t: 'ph', occ: pi++ });
      last = m.index + m[0].length;
    }
    if (last < tpl.length) parts.push({ t: 'text', v: tpl.slice(last) });
    return parts;
  }

  // Beispiel-/Hilfezeile für einen Schritt
  function fieldExample(f) {
    if (f.options.length > 1) return 'Wähle etwas aus oder schreib es selbst.';
    if (f.hint) return f.hint;
    if (f.long) return 'Hier darf ruhig mehr Text stehen, auch ganze Sätze.';
    return ''; // selbsterklärende Felder brauchen keinen Fülltext
  }

  // Zeigt die Textstelle rund um den aktuellen Platzhalter
  function renderContext(field) {
    const parts = tokenize(currentTemplate);
    let target = -1;
    for (let i = 0; i < parts.length; i++) {
      if (parts[i].t === 'ph' && occurrences[parts[i].occ] && occurrences[parts[i].occ].key === field.key) { target = i; break; }
    }
    if (target < 0) { wzContext.hidden = true; return; }

    let left = '', right = '';
    for (let i = target - 1; i >= 0; i--) { if (parts[i].t === 'text') { left = parts[i].v; break; } }
    for (let i = target + 1; i < parts.length; i++) { if (parts[i].t === 'text') { right = parts[i].v; break; } }

    let leftSeg = left.split(/\n/).pop();
    const lTrim = leftSeg.length > 70;
    if (lTrim) leftSeg = leftSeg.slice(-70).replace(/^\S*\s/, '');
    // Kosmetik der Vorschau: Markdown-Fett & führende Satzzeichen weg (Prompt selbst bleibt unberührt)
    leftSeg = leftSeg.replace(/\*\*/g, '').replace(/^[\s.;:!?]+/, '');
    let rightSeg = right.split(/\n/)[0];
    const rTrim = rightSeg.length > 70;
    if (rTrim) rightSeg = rightSeg.slice(0, 70).replace(/\s\S*$/, '');
    rightSeg = rightSeg.replace(/\*\*/g, '');

    const val = (fieldValues.get(field.key) || '').trim();
    wzContextText.innerHTML =
      (lTrim ? '… ' : '') + escapeHtml(leftSeg) +
      '<mark>' + escapeHtml(val || field.label) + '</mark>' +
      escapeHtml(rightSeg) + (rTrim ? ' …' : '');
    wzContext.hidden = false;
  }

  // Standard-Kontext (Fach/Klassenstufe) merken, sobald ein solches Feld ausgefüllt wird
  function maybeSaveCtx(field, value) {
    const kind = contextKindOf(field);
    if (!kind) return;
    const v = (value || '').trim();
    if (!v) return;
    if (ctxDefaults[kind] === v) return;
    ctxDefaults[kind] = v;
    saveCtx();
    reflectCtxReset();
  }

  // ---- Alle-Felder-Ansicht (Profi) ----
  function buildAllFields() {
    builderFields.innerHTML = '';
    wizardFields.forEach((f, i) => {
      const wrap = document.createElement('label');
      wrap.className = 'builder-field' + (f.long ? ' builder-field-wide' : '');
      const span = document.createElement('span');
      span.textContent = f.label;
      wrap.appendChild(span);
      if (f.hint) {
        const small = document.createElement('small');
        small.textContent = f.hint;
        wrap.appendChild(small);
      }
      let input;
      if (f.long) {
        input = document.createElement('textarea');
        input.rows = 3;
      } else {
        input = document.createElement('input');
        input.type = 'text';
        if (f.options.length > 1) {
          const dl = document.createElement('datalist');
          dl.id = 'dl-' + i;
          f.options.forEach((o) => { const op = document.createElement('option'); op.value = o; dl.appendChild(op); });
          input.setAttribute('list', dl.id);
          wrap.appendChild(dl);
        }
      }
      input.value = fieldValues.get(f.key) || '';
      input.placeholder = f.options.length > 1 ? f.options.join(' / ') : (f.long ? '' : (f.hint || ''));
      input.autocomplete = 'off';
      input.addEventListener('input', () => { fieldValues.set(f.key, input.value); renderPreview(); });
      input.addEventListener('change', () => maybeSaveCtx(f, input.value));
      wrap.appendChild(input);
      builderFields.appendChild(wrap);
    });
  }

  // ---- Assistent (Schritt für Schritt) ----
  function renderStep() {
    const total = wizardFields.length;
    const f = wizardFields[wizardIndex];
    wzStep.hidden = false;
    wzDone.hidden = true;
    showResult(false);
    wzCount.textContent = 'Schritt ' + (wizardIndex + 1) + ' von ' + total;
    wzDots.innerHTML = '';
    for (let i = 0; i < total; i++) {
      const d = document.createElement('span');
      d.className = 'wz-dot' + (i < wizardIndex ? ' done' : '') + (i === wizardIndex ? ' active' : '');
      wzDots.appendChild(d);
    }

    wzQ.textContent = f.label;
    const help = fieldExample(f);
    wzHelp.textContent = help;
    wzHelp.hidden = !help;

    wzInput.innerHTML = '';
    const val = fieldValues.get(f.key) || '';
    let inputEl;
    if (f.long) { inputEl = document.createElement('textarea'); inputEl.rows = 4; }
    else { inputEl = document.createElement('input'); inputEl.type = 'text'; }
    inputEl.className = 'wz-field';
    inputEl.value = val;
    inputEl.placeholder = f.options.length > 1 ? 'Auswählen oder selbst eingeben …' : 'Hier eingeben …';
    inputEl.autocomplete = 'off';
    inputEl.addEventListener('input', () => { fieldValues.set(f.key, inputEl.value); renderContext(f); renderPreview(); });
    inputEl.addEventListener('change', () => maybeSaveCtx(f, inputEl.value));
    if (!f.long) {
      inputEl.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); goNext(); } });
    }

    if (f.options.length > 1) {
      const chips = document.createElement('div');
      chips.className = 'wz-chips';
      f.options.forEach((o) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'wz-chip' + (val === o ? ' selected' : '');
        b.textContent = o;
        b.addEventListener('click', () => {
          fieldValues.set(f.key, o);
          inputEl.value = o;
          chips.querySelectorAll('.wz-chip').forEach((c) => c.classList.remove('selected'));
          b.classList.add('selected');
          renderContext(f); renderPreview(); maybeSaveCtx(f, o);
        });
        chips.appendChild(b);
      });
      wzInput.appendChild(chips);
    }
    wzInput.appendChild(inputEl);

    renderContext(f);

    wzBack.disabled = wizardIndex === 0;
    wzNext.textContent = wizardIndex === total - 1 ? 'Fertig ✓' : 'Weiter';
    setTimeout(() => inputEl.focus(), 50);
  }

  function goNext() {
    if (wizardIndex < wizardFields.length - 1) { wizardIndex++; renderStep(); }
    else { showDone(); }
  }
  function goBack() { if (wizardIndex > 0) { wizardIndex--; renderStep(); } }
  function skipStep() {
    fieldValues.set(wizardFields[wizardIndex].key, '');
    renderPreview();
    goNext();
  }

  function showDone() {
    renderPreview();
    wzStep.hidden = true;
    wzDone.hidden = false;
    showResult(true);
  }

  function showAll() {
    builder.hidden = false;
    wizard.hidden = true;
    showResult(true);
    buildAllFields();
    renderPreview();
  }

  function showWizard() {
    builder.hidden = true;
    wizard.hidden = false;
    renderStep();
  }

  // Baut Assistent + Alle-Felder-Ansicht für ein Template auf
  function setupPlaceholders(template) {
    currentTemplate = template;
    wizardFields = analyze(template); // füllt zugleich `occurrences`
    fieldValues.clear();
    wizardFields.forEach((f) => {
      // Standard-Kontext (Fach/Klassenstufe) aus localStorage vorbelegen
      const kind = contextKindOf(f);
      fieldValues.set(f.key, kind && ctxDefaults[kind] ? ctxDefaults[kind] : '');
    });
    wizardIndex = 0;

    if (wizardFields.length === 0) {
      wizard.hidden = true;
      builder.hidden = true;
      showResult(true);
      renderPreview();
      return;
    }
    builder.hidden = true;
    wizard.hidden = false;
    renderPreview(); // #m-prompt + Deeplinks initial mit Template (Platzhalter bleiben) füllen
    renderStep();
  }

  wzNext.addEventListener('click', goNext);
  wzBack.addEventListener('click', goBack);
  wzSkip.addEventListener('click', skipStep);
  wzToggleAll.addEventListener('click', showAll);
  wzToggleWizard.addEventListener('click', showWizard);
  wzDoneReset.addEventListener('click', () => { wizardIndex = 0; renderStep(); });

  builderReset.addEventListener('click', () => {
    builderFields.querySelectorAll('input, textarea').forEach((el) => { el.value = ''; });
    fieldValues.forEach((_, k) => fieldValues.set(k, ''));
    renderPreview();
  });

  // Nachfass-Chips: aus Prompt-Daten oder generische Defaults
  function buildNachfass(p) {
    const list = (Array.isArray(p.nachfassPrompts) && p.nachfassPrompts.length)
      ? p.nachfassPrompts
      : DEFAULT_NACHFASS;
    mNachfassChips.innerHTML = '';
    list.forEach((text) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'nachfass-chip';
      b.textContent = text;
      b.addEventListener('click', async () => {
        const ok = await copyToClipboard(text);
        const prev = b.textContent;
        b.classList.toggle('copied', ok);
        b.textContent = ok ? '✓ Kopiert' : 'Fehler';
        clearTimeout(b._t);
        b._t = setTimeout(() => { b.classList.remove('copied'); b.textContent = prev; }, 1500);
      });
      mNachfassChips.appendChild(b);
    });
    mNachfass.hidden = false;
  }

  function openModal(id) {
    const p = data[id];
    if (!p) return;
    mTitle.textContent = p.title;
    mDesc.textContent = p.description;
    setupPlaceholders(p.prompt);
    // Datenschutz-Ampel
    mPrivacy.hidden = !p.personenbezug;
    // Zielkanäle zurücksetzen
    mAisHint.hidden = true;
    if (otherTools) otherTools.open = false;
    buildNachfass(p);
    mBadges.innerHTML = `<span class="badge badge-cat">${p.category}</span><span class="badge badge-stage">${p.stage}</span><span class="badge badge-subject">${p.subject}</span>${p.community ? '<span class="badge badge-community">Community</span>' : ''}${p.personenbezug ? '<span class="badge badge-personenbezug">Personenbezug</span>' : ''}`;
    if (p.hint) { mHint.textContent = 'Hinweis: ' + p.hint; mHint.hidden = false; }
    else { mHint.hidden = true; }
    modal.hidden = false;
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    if (location.hash !== '#p-' + id) history.replaceState(null, '', '#p-' + id);
  }

  function closeModal() {
    modal.hidden = true;
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    if (location.hash.startsWith('#p-')) history.replaceState(null, '', location.pathname + location.search);
  }

  cards.forEach((card) => {
    card.addEventListener('click', () => openModal(card.dataset.id));
    card.setAttribute('tabindex', '0');
    card.setAttribute('role', 'button');
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openModal(card.dataset.id); }
    });
  });

  // Copy-Button direkt auf der Karte (ohne Modal zu öffnen)
  const COPY_ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg> Kopieren';
  const CHECK_ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg> Kopiert';

  grid.querySelectorAll('.card-copy').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const p = data[btn.dataset.copyId];
      if (!p) return;
      try {
        await navigator.clipboard.writeText(p.prompt);
        btn.classList.add('copied');
        btn.innerHTML = CHECK_ICON;
        clearTimeout(btn._t);
        btn._t = setTimeout(() => {
          btn.classList.remove('copied');
          btn.innerHTML = COPY_ICON;
        }, 1800);
      } catch (err) {
        btn.textContent = 'Fehler';
      }
    });
    // Tastatur-Aktivierung des Buttons nicht an die Karte weiterreichen
    btn.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') e.stopPropagation();
    });
  });

  modal.addEventListener('click', (e) => {
    if (e.target.closest('[data-close]')) closeModal();
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) closeModal(); });

  const M_COPY_LABEL = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg> Kopieren';
  const M_COPY_DONE = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg> Kopiert';
  mCopy.addEventListener('click', async () => {
    const ok = await copyToClipboard(mPrompt.textContent);
    mCopy.classList.toggle('copied', ok);
    mCopy.innerHTML = ok ? M_COPY_DONE : '⚠ Fehler';
    clearTimeout(mCopy._t);
    mCopy._t = setTimeout(() => { mCopy.classList.remove('copied'); mCopy.innerHTML = M_COPY_LABEL; }, 1800);
  });

  // Primäraktion: Prompt kopieren UND AIS.chat in neuem Tab öffnen (kein Prefill-Param verfügbar)
  const AIS_LABEL = mAis.innerHTML;
  mAis.addEventListener('click', async () => {
    const ok = await copyToClipboard(mPrompt.textContent);
    // Neuer Tab, sicher entkoppelt
    window.open(AIS_URL, '_blank', 'noopener');
    mAisHint.textContent = ok
      ? AIS_HINT_TEXT
      : '⚠ Kopieren hat nicht geklappt. Tippe oben auf „Kopieren" und füge den Prompt in AIS.chat mit Strg+V ein.';
    mAisHint.className = 'ais-hint' + (ok ? '' : ' ais-hint-error');
    mAisHint.hidden = false;
  });

  // Copilot: kein zuverlässiger Prefill -> kopieren & öffnen (gleiches Muster wie AIS.chat)
  dlCopilot.addEventListener('click', async () => {
    const ok = await copyToClipboard(mPrompt.textContent);
    window.open(COPILOT_URL, '_blank', 'noopener');
    const prev = dlCopilot.textContent;
    dlCopilot.textContent = ok ? '✓ Kopiert – in Copilot einfügen' : '⚠ Fehler';
    clearTimeout(dlCopilot._t);
    dlCopilot._t = setTimeout(() => { dlCopilot.textContent = prev; }, 2200);
  });

  // ChatGPT/Claude-Deeplinks kopieren den Prompt zusätzlich, damit bei zu langem
  // Prefill oder Blockade trotzdem ein Fallback in der Zwischenablage liegt.
  [dlChatgpt, dlClaude].forEach((a) => {
    a.addEventListener('click', () => { copyToClipboard(mPrompt.textContent); });
  });

  // Teilen: Direktlink zum aktuell geöffneten Prompt kopieren
  const SHARE_LABEL = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg> Link kopieren';
  mShare.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(location.href);
      mShare.classList.add('copied');
      mShare.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg> Link kopiert';
      clearTimeout(mShare._t);
      mShare._t = setTimeout(() => { mShare.classList.remove('copied'); mShare.innerHTML = SHARE_LABEL; }, 1800);
    } catch (e) {
      mShare.textContent = 'Fehler beim Kopieren';
    }
  });

  // Direktlink beim Laden: #p-<id> öffnet den passenden Prompt
  const hashId = location.hash.startsWith('#p-') ? location.hash.slice(3) : '';
  if (hashId && data[hashId]) openModal(hashId);

  // ===== Submit-Form =====
  const FORM_ENDPOINT = 'https://prompt-profi-forms.gbabing.workers.dev';

  const openSubmit = document.getElementById('open-submit');
  const submitModal = document.getElementById('submit-modal');
  const submitBtn = document.getElementById('submit-btn');
  const formStatus = document.getElementById('form-status');

  const fTitle = document.getElementById('f-title');
  const fDesc = document.getElementById('f-description');
  const fCategory = document.getElementById('f-category');
  const fStageSub = document.getElementById('f-stage-sub');
  const fSubjectInput = document.getElementById('f-subject-input');
  const fPrompt = document.getElementById('f-prompt');
  const fWebsite = document.getElementById('f-website');

  function openSubmitModal() {
    submitModal.hidden = false;
    submitModal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    formStatus.hidden = true;
    setTimeout(() => fTitle.focus(), 100);
  }

  function closeSubmitModal() {
    submitModal.hidden = true;
    submitModal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  openSubmit.addEventListener('click', openSubmitModal);
  submitModal.addEventListener('click', (e) => {
    if (e.target.closest('[data-submit-close]')) closeSubmitModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !submitModal.hidden) closeSubmitModal();
  });

  function showStatus(text, type) {
    formStatus.textContent = text;
    formStatus.className = 'form-status status-' + type;
    formStatus.hidden = false;
  }

  submitBtn.addEventListener('click', async () => {
    // Client-seitige Validierung
    const fields = [
      { el: fTitle, name: 'Titel' },
      { el: fDesc, name: 'Kurzbeschreibung' },
      { el: fCategory, name: 'Kategorie' },
      { el: fStageSub, name: 'Schulstufe' },
      { el: fSubjectInput, name: 'Fach' },
      { el: fPrompt, name: 'Prompt-Text' },
    ];
    for (const f of fields) {
      if (!f.el.value || f.el.value.trim().length === 0) {
        showStatus(`Bitte fülle das Feld "${f.name}" aus.`, 'error');
        f.el.focus();
        return;
      }
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Wird übermittelt …';
    showStatus('Einreichung wird übermittelt …', 'info');

    try {
      const res = await fetch(FORM_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title: fTitle.value.trim(),
          description: fDesc.value.trim(),
          category: fCategory.value,
          stage: fStageSub.value,
          subject: fSubjectInput.value.trim(),
          prompt: fPrompt.value.trim(),
          website: fWebsite.value,
        }),
      });

      const result = await res.json();

      if (res.ok) {
        showStatus('Vielen Dank! Dein Prompt wurde eingereicht und wird geprüft.', 'success');
        // Felder leeren
        fTitle.value = ''; fDesc.value = ''; fCategory.value = '';
        fStageSub.value = ''; fSubjectInput.value = ''; fPrompt.value = '';
        setTimeout(closeSubmitModal, 2500);
      } else {
        showStatus('Fehler: ' + (result.error || 'Unbekannt'), 'error');
      }
    } catch (e) {
      showStatus('Netzwerkfehler. Bitte später erneut versuchen.', 'error');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Einreichen';
    }
  });
</script>
</Layout>
